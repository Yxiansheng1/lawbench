{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lawbench://contracts/api/pipeline_run.schema.json",
  "title": "POST /api/pipeline/run",
  "description": "运行流水线（本次只有案件 wiki 的生成和更新）",
  "$defs": {
    "request": {
      "type": "object",
      "properties": {
        "case_id": {
          "$ref": "lawbench://contracts/common.schema.json#/$defs/case_id"
        },
        "step": {
          "enum": [
            "wiki_build",
            "wiki_update"
          ]
        },
        "use_prep": {
          "type": "boolean",
          "description": "字段抽取和分类用 395 的 9B（路由表：律师勾选即授权）"
        },
        "params": {
          "$ref": "lawbench://contracts/common.schema.json#/$defs/params"
        }
      },
      "additionalProperties": false,
      "required": [
        "case_id",
        "step",
        "use_prep",
        "params"
      ]
    },
    "response": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "ok": {
              "const": true
            },
            "value": {
              "type": "object",
              "properties": {
                "task_id": {
                  "$ref": "lawbench://contracts/common.schema.json#/$defs/task_id"
                }
              },
              "additionalProperties": false,
              "required": [
                "task_id"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "ok",
            "value"
          ]
        },
        {
          "$ref": "lawbench://contracts/common.schema.json#/$defs/fail"
        }
      ]
    },
    "value": {
      "type": "object",
      "properties": {
        "task_id": {
          "$ref": "lawbench://contracts/common.schema.json#/$defs/task_id"
        }
      },
      "additionalProperties": false,
      "required": [
        "task_id"
      ]
    }
  }
}
