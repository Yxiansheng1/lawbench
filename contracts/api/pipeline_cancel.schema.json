{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lawbench://contracts/api/pipeline_cancel.schema.json",
  "title": "POST /api/pipeline/{task_id}/cancel",
  "description": "取消流水线；已完成的步骤存为草稿",
  "$defs": {
    "request": {
      "type": "object",
      "properties": {
        "task_id": {
          "$ref": "lawbench://contracts/common.schema.json#/$defs/task_id"
        }
      },
      "additionalProperties": false,
      "required": [
        "task_id"
      ]
    },
    "response": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "ok": {
              "const": true
            },
            "value": {
              "type": "object",
              "properties": {},
              "additionalProperties": false,
              "required": []
            }
          },
          "additionalProperties": false,
          "required": [
            "ok",
            "value"
          ]
        },
        {
          "$ref": "lawbench://contracts/common.schema.json#/$defs/fail"
        }
      ]
    },
    "value": {
      "type": "object",
      "properties": {},
      "additionalProperties": false,
      "required": []
    }
  }
}
