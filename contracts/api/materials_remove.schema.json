{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lawbench://contracts/api/materials_remove.schema.json",
  "title": "POST /api/materials/remove",
  "description": "律师移除材料（1.4 起）：原件移到系统回收站（不永久删除），清掉材料文本、识别页、检索记录；index.json 里保留这一条、状态 removed，编号不复用。已移除的再移除不报错（幂等）",
  "$defs": {
    "request": {
      "type": "object",
      "properties": {
        "case_id": {
          "$ref": "lawbench://contracts/common.schema.json#/$defs/case_id"
        },
        "material_ids": {
          "type": "array",
          "items": {
            "$ref": "lawbench://contracts/common.schema.json#/$defs/material_id"
          },
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true
        }
      },
      "additionalProperties": false,
      "required": [
        "case_id",
        "material_ids"
      ]
    },
    "response": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "ok": {
              "const": true
            },
            "value": {
              "type": "object",
              "properties": {
                "removed": {
                  "type": "array",
                  "items": {
                    "$ref": "lawbench://contracts/common.schema.json#/$defs/material_id"
                  }
                },
                "already_removed": {
                  "type": "array",
                  "items": {
                    "$ref": "lawbench://contracts/common.schema.json#/$defs/material_id"
                  }
                },
                "failed": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "material_id": {
                        "$ref": "lawbench://contracts/common.schema.json#/$defs/material_id"
                      },
                      "reason": {
                        "type": "string",
                        "description": "中文原因，不含路径"
                      }
                    },
                    "additionalProperties": false,
                    "required": [
                      "material_id",
                      "reason"
                    ]
                  }
                },
                "wiki_needs_update": {
                  "type": "boolean",
                  "description": "被移除的材料在 wiki 生成时用过，请律师更新 wiki"
                }
              },
              "additionalProperties": false,
              "required": [
                "removed",
                "already_removed",
                "failed",
                "wiki_needs_update"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "ok",
            "value"
          ]
        },
        {
          "$ref": "lawbench://contracts/common.schema.json#/$defs/fail"
        }
      ]
    },
    "value": {
      "type": "object",
      "properties": {
        "removed": {
          "type": "array",
          "items": {
            "$ref": "lawbench://contracts/common.schema.json#/$defs/material_id"
          }
        },
        "already_removed": {
          "type": "array",
          "items": {
            "$ref": "lawbench://contracts/common.schema.json#/$defs/material_id"
          }
        },
        "failed": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "material_id": {
                "$ref": "lawbench://contracts/common.schema.json#/$defs/material_id"
              },
              "reason": {
                "type": "string",
                "description": "中文原因，不含路径"
              }
            },
            "additionalProperties": false,
            "required": [
              "material_id",
              "reason"
            ]
          }
        },
        "wiki_needs_update": {
          "type": "boolean",
          "description": "被移除的材料在 wiki 生成时用过，请律师更新 wiki"
        }
      },
      "additionalProperties": false,
      "required": [
        "removed",
        "already_removed",
        "failed",
        "wiki_needs_update"
      ]
    }
  }
}
