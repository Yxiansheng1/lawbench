{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lawbench://contracts/api/case_forget.schema.json",
  "title": "POST /api/case/forget",
  "description": "从最近案件里移除一个案件（1.4 起）：只删 cases.json 里的这条登记，case_recent 不再列出；案件文件夹和里面的一切都不动，以后再打开同一个文件夹仍是原来的案件。没有登记的不报错（幂等）",
  "$defs": {
    "request": {
      "type": "object",
      "properties": {
        "case_id": {
          "$ref": "lawbench://contracts/common.schema.json#/$defs/case_id"
        }
      },
      "additionalProperties": false,
      "required": [
        "case_id"
      ]
    },
    "response": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "ok": {
              "const": true
            },
            "value": {
              "type": "object",
              "properties": {
                "already_forgotten": {
                  "type": "boolean",
                  "description": "本来就没有登记（包括已经移除过）"
                }
              },
              "additionalProperties": false,
              "required": [
                "already_forgotten"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "ok",
            "value"
          ]
        },
        {
          "$ref": "lawbench://contracts/common.schema.json#/$defs/fail"
        }
      ]
    },
    "value": {
      "type": "object",
      "properties": {
        "already_forgotten": {
          "type": "boolean",
          "description": "本来就没有登记（包括已经移除过）"
        }
      },
      "additionalProperties": false,
      "required": [
        "already_forgotten"
      ]
    }
  }
}
