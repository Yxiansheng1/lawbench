{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lawbench://contracts/api/case_open.schema.json",
  "title": "POST /api/case/open",
  "description": "打开或新建案件；登记到 cases.json。云同步目录报 CASE_IN_SYNC_FOLDER，链接或 junction 报 CASE_ROOT_IS_LINK",
  "$defs": {
    "request": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "description": "律师选的文件夹绝对路径"
        },
        "template": {
          "anyOf": [
            {
              "enum": [
                "civil",
                "criminal"
              ],
              "description": "新建案件时按标准目录建子文件夹（formats.md 第 1.1 节）；只补缺，不改已有文件夹"
            },
            {
              "type": "null"
            }
          ]
        },
        "folders": {
          "type": "array",
          "items": {
            "$ref": "lawbench://contracts/common.schema.json#/$defs/rel_path"
          },
          "maxItems": 200,
          "uniqueItems": true,
          "description": "律师勾选要建的子文件夹（1.4 起）：给了就只建这些（必须都在 template 对应的标准目录表里），不给按 template 全建；只补缺"
        }
      },
      "additionalProperties": false,
      "required": [
        "path"
      ]
    },
    "response": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "ok": {
              "const": true
            },
            "value": {
              "type": "object",
              "properties": {
                "case_id": {
                  "$ref": "lawbench://contracts/common.schema.json#/$defs/case_id"
                },
                "name": {
                  "type": "string",
                  "description": "文件夹名"
                },
                "created": {
                  "type": "boolean",
                  "description": "本次新建了 工作区/"
                },
                "folders_created": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "本次按目录模板新建的子文件夹"
                }
              },
              "additionalProperties": false,
              "required": [
                "case_id",
                "name",
                "created",
                "folders_created"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "ok",
            "value"
          ]
        },
        {
          "$ref": "lawbench://contracts/common.schema.json#/$defs/fail"
        }
      ]
    },
    "value": {
      "type": "object",
      "properties": {
        "case_id": {
          "$ref": "lawbench://contracts/common.schema.json#/$defs/case_id"
        },
        "name": {
          "type": "string",
          "description": "文件夹名"
        },
        "created": {
          "type": "boolean",
          "description": "本次新建了 工作区/"
        },
        "folders_created": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "本次按目录模板新建的子文件夹"
        }
      },
      "additionalProperties": false,
      "required": [
        "case_id",
        "name",
        "created",
        "folders_created"
      ]
    }
  }
}
