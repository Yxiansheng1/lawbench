{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lawbench://contracts/api/case_open.schema.json",
  "title": "POST /api/case/open",
  "description": "打开或新建案件；登记到 cases.json。云同步目录报 CASE_IN_SYNC_FOLDER，链接或 junction 报 CASE_ROOT_IS_LINK",
  "$defs": {
    "request": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "description": "律师选的文件夹绝对路径"
        }
      },
      "additionalProperties": false,
      "required": [
        "path"
      ]
    },
    "response": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "ok": {
              "const": true
            },
            "value": {
              "type": "object",
              "properties": {
                "case_id": {
                  "$ref": "lawbench://contracts/common.schema.json#/$defs/case_id"
                },
                "name": {
                  "type": "string",
                  "description": "文件夹名"
                },
                "created": {
                  "type": "boolean",
                  "description": "本次新建了 工作区/"
                }
              },
              "additionalProperties": false,
              "required": [
                "case_id",
                "name",
                "created"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "ok",
            "value"
          ]
        },
        {
          "$ref": "lawbench://contracts/common.schema.json#/$defs/fail"
        }
      ]
    },
    "value": {
      "type": "object",
      "properties": {
        "case_id": {
          "$ref": "lawbench://contracts/common.schema.json#/$defs/case_id"
        },
        "name": {
          "type": "string",
          "description": "文件夹名"
        },
        "created": {
          "type": "boolean",
          "description": "本次新建了 工作区/"
        }
      },
      "additionalProperties": false,
      "required": [
        "case_id",
        "name",
        "created"
      ]
    }
  }
}
