{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lawbench://contracts/api/source.schema.json",
  "title": "GET /api/source?case_id=&material_id=&loc=",
  "description": "原文查看：返回定位单元的文本；PDF 另返回该页图片",
  "$defs": {
    "request": {
      "type": "object",
      "properties": {
        "case_id": {
          "$ref": "lawbench://contracts/common.schema.json#/$defs/case_id"
        },
        "material_id": {
          "$ref": "lawbench://contracts/common.schema.json#/$defs/material_id"
        },
        "citation": {
          "$ref": "lawbench://contracts/common.schema.json#/$defs/citation_text"
        }
      },
      "additionalProperties": false,
      "required": [
        "case_id",
        "material_id",
        "citation"
      ]
    },
    "response": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "ok": {
              "const": true
            },
            "value": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "loc": {
                  "$ref": "lawbench://contracts/common.schema.json#/$defs/loc"
                },
                "text": {
                  "type": "string"
                },
                "page_png_base64": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "source_changed": {
                  "type": "boolean",
                  "description": "原件哈希已与出处记录不同"
                }
              },
              "additionalProperties": false,
              "required": [
                "name",
                "loc",
                "text",
                "page_png_base64",
                "source_changed"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "ok",
            "value"
          ]
        },
        {
          "$ref": "lawbench://contracts/common.schema.json#/$defs/fail"
        }
      ]
    },
    "value": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "loc": {
          "$ref": "lawbench://contracts/common.schema.json#/$defs/loc"
        },
        "text": {
          "type": "string"
        },
        "page_png_base64": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_changed": {
          "type": "boolean",
          "description": "原件哈希已与出处记录不同"
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "loc",
        "text",
        "page_png_base64",
        "source_changed"
      ]
    }
  }
}
