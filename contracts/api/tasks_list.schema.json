{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lawbench://contracts/api/tasks_list.schema.json",
  "title": "GET /api/tasks?case_id=",
  "description": "本案任务列表（成果区用），数据来自各任务的 result.json；只列已开始执行的任务，还没执行的选择（待执行任务单）不列（1.2 写明）",
  "$defs": {
    "request": {
      "type": "object",
      "properties": {
        "case_id": {
          "$ref": "lawbench://contracts/common.schema.json#/$defs/case_id"
        }
      },
      "additionalProperties": false,
      "required": [
        "case_id"
      ]
    },
    "response": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "ok": {
              "const": true
            },
            "value": {
              "type": "object",
              "properties": {
                "tasks": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "task_id": {
                        "$ref": "lawbench://contracts/common.schema.json#/$defs/task_id"
                      },
                      "skill": {
                        "anyOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "status": {
                        "type": "string"
                      },
                      "drafts": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "title": {
                              "type": "string"
                            },
                            "path": {
                              "$ref": "lawbench://contracts/common.schema.json#/$defs/rel_path"
                            },
                            "version": {
                              "type": "integer",
                              "minimum": 1
                            }
                          },
                          "additionalProperties": false,
                          "required": [
                            "title",
                            "path",
                            "version"
                          ]
                        }
                      },
                      "citation_passed": {
                        "anyOf": [
                          {
                            "type": "boolean"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "finished_at": {
                        "anyOf": [
                          {
                            "$ref": "lawbench://contracts/common.schema.json#/$defs/time"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "coverage": {
                        "anyOf": [
                          {
                            "$ref": "lawbench://contracts/common.schema.json#/$defs/coverage"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "citation_check": {
                        "anyOf": [
                          {
                            "$ref": "lawbench://contracts/common.schema.json#/$defs/citation_check"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      }
                    },
                    "additionalProperties": false,
                    "required": [
                      "task_id",
                      "skill",
                      "status",
                      "drafts",
                      "citation_passed",
                      "finished_at",
                      "coverage",
                      "citation_check"
                    ]
                  }
                }
              },
              "additionalProperties": false,
              "required": [
                "tasks"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "ok",
            "value"
          ]
        },
        {
          "$ref": "lawbench://contracts/common.schema.json#/$defs/fail"
        }
      ]
    },
    "value": {
      "type": "object",
      "properties": {
        "tasks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "task_id": {
                "$ref": "lawbench://contracts/common.schema.json#/$defs/task_id"
              },
              "skill": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "status": {
                "type": "string"
              },
              "drafts": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "title": {
                      "type": "string"
                    },
                    "path": {
                      "$ref": "lawbench://contracts/common.schema.json#/$defs/rel_path"
                    },
                    "version": {
                      "type": "integer",
                      "minimum": 1
                    }
                  },
                  "additionalProperties": false,
                  "required": [
                    "title",
                    "path",
                    "version"
                  ]
                }
              },
              "citation_passed": {
                "anyOf": [
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "finished_at": {
                "anyOf": [
                  {
                    "$ref": "lawbench://contracts/common.schema.json#/$defs/time"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "coverage": {
                "anyOf": [
                  {
                    "$ref": "lawbench://contracts/common.schema.json#/$defs/coverage"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "citation_check": {
                "anyOf": [
                  {
                    "$ref": "lawbench://contracts/common.schema.json#/$defs/citation_check"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "additionalProperties": false,
            "required": [
              "task_id",
              "skill",
              "status",
              "drafts",
              "citation_passed",
              "finished_at",
              "coverage",
              "citation_check"
            ]
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "tasks"
      ]
    }
  }
}
