{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lawbench://contracts/api/materials_scan.schema.json",
  "title": "POST /api/materials/scan",
  "description": "扫描原件区并在本机解析新增或变化的材料（同步返回汇总）",
  "$defs": {
    "request": {
      "type": "object",
      "properties": {
        "case_id": {
          "$ref": "lawbench://contracts/common.schema.json#/$defs/case_id"
        }
      },
      "additionalProperties": false,
      "required": [
        "case_id"
      ]
    },
    "response": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "ok": {
              "const": true
            },
            "value": {
              "type": "object",
              "properties": {
                "added": {
                  "type": "integer",
                  "minimum": 0
                },
                "changed": {
                  "type": "integer",
                  "minimum": 0
                },
                "removed": {
                  "type": "integer",
                  "minimum": 0
                },
                "failed": {
                  "type": "integer",
                  "minimum": 0
                },
                "review_needed": {
                  "type": "boolean",
                  "description": "有材料变化，wiki 和已有成果需要复核"
                }
              },
              "additionalProperties": false,
              "required": [
                "added",
                "changed",
                "removed",
                "failed",
                "review_needed"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "ok",
            "value"
          ]
        },
        {
          "$ref": "lawbench://contracts/common.schema.json#/$defs/fail"
        }
      ]
    },
    "value": {
      "type": "object",
      "properties": {
        "added": {
          "type": "integer",
          "minimum": 0
        },
        "changed": {
          "type": "integer",
          "minimum": 0
        },
        "removed": {
          "type": "integer",
          "minimum": 0
        },
        "failed": {
          "type": "integer",
          "minimum": 0
        },
        "review_needed": {
          "type": "boolean",
          "description": "有材料变化，wiki 和已有成果需要复核"
        }
      },
      "additionalProperties": false,
      "required": [
        "added",
        "changed",
        "removed",
        "failed",
        "review_needed"
      ]
    }
  }
}
