{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lawbench://contracts/api/invoice_run.schema.json",
  "title": "POST /api/invoice/run",
  "description": "发票整理：按白名单调用发票引擎（engines/invoice-ledger）的一个动作；台账固定在 <日常办公文件夹>/发票台账。不支持邮箱联网收取和正文链接下载",
  "$defs": {
    "request": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "action": {
              "enum": [
                "env_check",
                "report",
                "check_schema"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "action"
          ]
        },
        {
          "type": "object",
          "properties": {
            "action": {
              "const": "history"
            },
            "period": {
              "type": "string",
              "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$"
            }
          },
          "additionalProperties": false,
          "required": [
            "action",
            "period"
          ]
        },
        {
          "type": "object",
          "properties": {
            "action": {
              "const": "plan"
            },
            "period": {
              "type": "string",
              "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$"
            },
            "channel": {
              "enum": [
                "local",
                "eml"
              ]
            },
            "history": {
              "enum": [
                "exclude",
                "selected"
              ]
            },
            "history_numbers": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[0-9]{18,20}$",
                "description": "发票号码 18–20 位数字（1.3 起与引擎一致，原 8–20）"
              }
            },
            "start": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
                  "description": "邮件搜索起始日期 YYYY-MM-DD；channel=eml 时必填（1.3 起）"
                },
                {
                  "type": "null"
                }
              ]
            },
            "end": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
                  "description": "邮件搜索截止日期 YYYY-MM-DD；channel=eml 时必填（1.3 起）"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "action",
            "period",
            "channel",
            "history",
            "history_numbers"
          ]
        },
        {
          "type": "object",
          "properties": {
            "action": {
              "const": "run"
            },
            "period": {
              "type": "string",
              "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$"
            },
            "batch": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_\\u4e00-\\u9fff-]{1,40}$",
              "minLength": 1,
              "maxLength": 40
            },
            "src": {
              "$ref": "lawbench://contracts/common.schema.json#/$defs/abs_path"
            },
            "channel": {
              "enum": [
                "local",
                "eml"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "action",
            "period",
            "batch",
            "src",
            "channel"
          ]
        },
        {
          "type": "object",
          "properties": {
            "action": {
              "enum": [
                "analyze",
                "import"
              ]
            },
            "period": {
              "type": "string",
              "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$"
            }
          },
          "additionalProperties": false,
          "required": [
            "action",
            "period"
          ]
        },
        {
          "type": "object",
          "properties": {
            "action": {
              "const": "prepare"
            },
            "period": {
              "type": "string",
              "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$"
            },
            "batch": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_\\u4e00-\\u9fff-]{1,40}$",
              "minLength": 1,
              "maxLength": 40
            },
            "replace": {
              "type": "boolean"
            }
          },
          "additionalProperties": false,
          "required": [
            "action",
            "period",
            "batch",
            "replace"
          ]
        },
        {
          "type": "object",
          "properties": {
            "action": {
              "const": "reprint"
            },
            "batch": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_\\u4e00-\\u9fff-]{1,40}$",
              "minLength": 1,
              "maxLength": 40
            }
          },
          "additionalProperties": false,
          "required": [
            "action",
            "batch"
          ]
        },
        {
          "type": "object",
          "properties": {
            "action": {
              "enum": [
                "cancel",
                "reimburse"
              ]
            },
            "batch": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_\\u4e00-\\u9fff-]{1,40}$",
              "minLength": 1,
              "maxLength": 40
            },
            "apply": {
              "type": "boolean",
              "description": "false 时只预览；cancel 引擎不支持预览，服务对 cancel 忽略 false、由界面先展示批次内容再确认（1.3 说明）"
            }
          },
          "additionalProperties": false,
          "required": [
            "action",
            "batch",
            "apply"
          ]
        },
        {
          "type": "object",
          "properties": {
            "action": {
              "const": "exclude"
            },
            "period": {
              "type": "string",
              "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$"
            },
            "item": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$",
              "description": "收集对账表里的记录 ID（64 位小写十六进制）"
            },
            "reason": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "description": "人工排除理由"
            },
            "reviewer": {
              "type": "string",
              "minLength": 1,
              "maxLength": 40,
              "description": "核验人"
            },
            "confirm": {
              "const": true,
              "description": "确认在界面做；服务一律带 --confirm（1.3 起，引擎 exclude 子命令：只改任务目录内的 collection.json 与对账表，不碰台账、不联网、不可逆）"
            }
          },
          "additionalProperties": false,
          "required": [
            "action",
            "period",
            "item",
            "reason",
            "reviewer",
            "confirm"
          ]
        },
        {
          "type": "object",
          "properties": {
            "action": {
              "const": "review"
            },
            "sha256": {
              "$ref": "lawbench://contracts/common.schema.json#/$defs/sha256"
            },
            "reviewer": {
              "type": "string",
              "minLength": 1
            },
            "confirm": {
              "type": "boolean"
            }
          },
          "additionalProperties": false,
          "required": [
            "action",
            "sha256",
            "reviewer",
            "confirm"
          ]
        }
      ]
    },
    "response": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "ok": {
              "const": true
            },
            "value": {
              "type": "object",
              "properties": {
                "exit_code": {
                  "type": "integer"
                },
                "attention": {
                  "type": "boolean",
                  "description": "引擎退出码 2 且输出不以 [BLOCKED] 开头：有重复、冲突、待核或部分失败，须看明细"
                },
                "failed": {
                  "type": "boolean",
                  "description": "引擎自己报失败（输出以 [BLOCKED] 开头，或退出码不是 0/2）；此时 attention=false，原因在 output 里给律师看（1.3 起）。服务自身的故障（引擎起不来、超时、被拒的参数）仍走失败体 ENGINE_FAILED / INVALID_ARGUMENT"
                },
                "output": {
                  "type": "string",
                  "description": "引擎输出原文，只在界面显示，不写日志"
                },
                "files": {
                  "type": "array",
                  "items": {
                    "$ref": "lawbench://contracts/common.schema.json#/$defs/abs_path"
                  }
                }
              },
              "additionalProperties": false,
              "required": [
                "exit_code",
                "attention",
                "failed",
                "output",
                "files"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "ok",
            "value"
          ]
        },
        {
          "$ref": "lawbench://contracts/common.schema.json#/$defs/fail"
        }
      ]
    },
    "value": {
      "type": "object",
      "properties": {
        "exit_code": {
          "type": "integer"
        },
        "attention": {
          "type": "boolean",
          "description": "引擎退出码 2 且输出不以 [BLOCKED] 开头：有重复、冲突、待核或部分失败，须看明细"
        },
        "failed": {
          "type": "boolean",
          "description": "引擎自己报失败（输出以 [BLOCKED] 开头，或退出码不是 0/2）；此时 attention=false，原因在 output 里给律师看（1.3 起）。服务自身的故障（引擎起不来、超时、被拒的参数）仍走失败体 ENGINE_FAILED / INVALID_ARGUMENT"
        },
        "output": {
          "type": "string",
          "description": "引擎输出原文，只在界面显示，不写日志"
        },
        "files": {
          "type": "array",
          "items": {
            "$ref": "lawbench://contracts/common.schema.json#/$defs/abs_path"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "exit_code",
        "attention",
        "failed",
        "output",
        "files"
      ]
    }
  }
}
