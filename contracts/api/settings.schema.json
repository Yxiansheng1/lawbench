{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lawbench://contracts/api/settings.schema.json",
  "title": "GET / PUT /api/settings",
  "description": "读写 settings.json；PUT 传完整对象",
  "$defs": {
    "request": {
      "$ref": "lawbench://contracts/files/settings.schema.json"
    },
    "response": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "ok": {
              "const": true
            },
            "value": {
              "$ref": "lawbench://contracts/files/settings.schema.json"
            }
          },
          "additionalProperties": false,
          "required": [
            "ok",
            "value"
          ]
        },
        {
          "$ref": "lawbench://contracts/common.schema.json#/$defs/fail"
        }
      ]
    },
    "value": {
      "$ref": "lawbench://contracts/files/settings.schema.json"
    }
  }
}
