{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lawbench://contracts/api/materials_list.schema.json",
  "title": "GET /api/materials?case_id=",
  "description": "材料列表（界面用，比 AI 工具多路径和页面信息）",
  "$defs": {
    "request": {
      "type": "object",
      "properties": {
        "case_id": {
          "$ref": "lawbench://contracts/common.schema.json#/$defs/case_id"
        }
      },
      "additionalProperties": false,
      "required": [
        "case_id"
      ]
    },
    "response": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "ok": {
              "const": true
            },
            "value": {
              "type": "object",
              "properties": {
                "materials": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "material_id": {
                        "$ref": "lawbench://contracts/common.schema.json#/$defs/material_id"
                      },
                      "name": {
                        "type": "string"
                      },
                      "rel_path": {
                        "$ref": "lawbench://contracts/common.schema.json#/$defs/rel_path"
                      },
                      "type": {
                        "$ref": "lawbench://contracts/common.schema.json#/$defs/material_type"
                      },
                      "status": {
                        "$ref": "lawbench://contracts/common.schema.json#/$defs/material_status"
                      },
                      "unit": {
                        "$ref": "lawbench://contracts/common.schema.json#/$defs/unit"
                      },
                      "unit_count": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "is_ocr": {
                        "$ref": "lawbench://contracts/common.schema.json#/$defs/ocr_state"
                      },
                      "stale_ocr": {
                        "type": "boolean"
                      },
                      "error": {
                        "anyOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "pages_need_ocr": {
                        "type": "array",
                        "items": {
                          "type": "integer",
                          "minimum": 1
                        }
                      },
                      "pages_mixed": {
                        "type": "array",
                        "items": {
                          "type": "integer",
                          "minimum": 1
                        }
                      }
                    },
                    "additionalProperties": false,
                    "required": [
                      "material_id",
                      "name",
                      "rel_path",
                      "type",
                      "status",
                      "unit",
                      "unit_count",
                      "is_ocr",
                      "stale_ocr",
                      "error",
                      "pages_need_ocr",
                      "pages_mixed"
                    ]
                  }
                }
              },
              "additionalProperties": false,
              "required": [
                "materials"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "ok",
            "value"
          ]
        },
        {
          "$ref": "lawbench://contracts/common.schema.json#/$defs/fail"
        }
      ]
    },
    "value": {
      "type": "object",
      "properties": {
        "materials": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "material_id": {
                "$ref": "lawbench://contracts/common.schema.json#/$defs/material_id"
              },
              "name": {
                "type": "string"
              },
              "rel_path": {
                "$ref": "lawbench://contracts/common.schema.json#/$defs/rel_path"
              },
              "type": {
                "$ref": "lawbench://contracts/common.schema.json#/$defs/material_type"
              },
              "status": {
                "$ref": "lawbench://contracts/common.schema.json#/$defs/material_status"
              },
              "unit": {
                "$ref": "lawbench://contracts/common.schema.json#/$defs/unit"
              },
              "unit_count": {
                "type": "integer",
                "minimum": 0
              },
              "is_ocr": {
                "$ref": "lawbench://contracts/common.schema.json#/$defs/ocr_state"
              },
              "stale_ocr": {
                "type": "boolean"
              },
              "error": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "pages_need_ocr": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "pages_mixed": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            },
            "additionalProperties": false,
            "required": [
              "material_id",
              "name",
              "rel_path",
              "type",
              "status",
              "unit",
              "unit_count",
              "is_ocr",
              "stale_ocr",
              "error",
              "pages_need_ocr",
              "pages_mixed"
            ]
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "materials"
      ]
    }
  }
}
