{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lawbench://contracts/api/case_recent.schema.json",
  "title": "GET /api/case/recent",
  "description": "最近案件（按最近打开时间倒序）",
  "$defs": {
    "request": {
      "type": "object",
      "properties": {},
      "additionalProperties": false,
      "required": []
    },
    "response": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "ok": {
              "const": true
            },
            "value": {
              "type": "object",
              "properties": {
                "cases": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "case_id": {
                        "$ref": "lawbench://contracts/common.schema.json#/$defs/case_id"
                      },
                      "name": {
                        "type": "string"
                      },
                      "root": {
                        "type": "string"
                      },
                      "last_opened": {
                        "$ref": "lawbench://contracts/common.schema.json#/$defs/time"
                      },
                      "exists": {
                        "type": "boolean",
                        "description": "文件夹是否还在"
                      }
                    },
                    "additionalProperties": false,
                    "required": [
                      "case_id",
                      "name",
                      "root",
                      "last_opened",
                      "exists"
                    ]
                  }
                }
              },
              "additionalProperties": false,
              "required": [
                "cases"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "ok",
            "value"
          ]
        },
        {
          "$ref": "lawbench://contracts/common.schema.json#/$defs/fail"
        }
      ]
    },
    "value": {
      "type": "object",
      "properties": {
        "cases": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "case_id": {
                "$ref": "lawbench://contracts/common.schema.json#/$defs/case_id"
              },
              "name": {
                "type": "string"
              },
              "root": {
                "type": "string"
              },
              "last_opened": {
                "$ref": "lawbench://contracts/common.schema.json#/$defs/time"
              },
              "exists": {
                "type": "boolean",
                "description": "文件夹是否还在"
              }
            },
            "additionalProperties": false,
            "required": [
              "case_id",
              "name",
              "root",
              "last_opened",
              "exists"
            ]
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "cases"
      ]
    }
  }
}
