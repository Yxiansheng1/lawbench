{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lawbench://contracts/api/outputs_confirm.schema.json",
  "title": "POST /api/outputs/confirm",
  "description": "律师确认草稿，导出到 成果/ 并写 成果/索引.json",
  "$defs": {
    "request": {
      "type": "object",
      "properties": {
        "case_id": {
          "$ref": "lawbench://contracts/common.schema.json#/$defs/case_id"
        },
        "task_id": {
          "$ref": "lawbench://contracts/common.schema.json#/$defs/task_id"
        },
        "draft": {
          "$ref": "lawbench://contracts/common.schema.json#/$defs/rel_path"
        },
        "formats": {
          "type": "array",
          "items": {
            "enum": [
              "md",
              "docx"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "template": {
          "anyOf": [
            {
              "enum": [
                "文书",
                "合同"
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "case_id",
        "task_id",
        "draft",
        "formats",
        "template"
      ]
    },
    "response": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "ok": {
              "const": true
            },
            "value": {
              "type": "object",
              "properties": {
                "outputs": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "format": {
                        "enum": [
                          "md",
                          "docx"
                        ]
                      },
                      "path": {
                        "$ref": "lawbench://contracts/common.schema.json#/$defs/rel_path"
                      },
                      "version": {
                        "type": "integer",
                        "minimum": 1
                      }
                    },
                    "additionalProperties": false,
                    "required": [
                      "format",
                      "path",
                      "version"
                    ]
                  }
                }
              },
              "additionalProperties": false,
              "required": [
                "outputs"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "ok",
            "value"
          ]
        },
        {
          "$ref": "lawbench://contracts/common.schema.json#/$defs/fail"
        }
      ]
    },
    "value": {
      "type": "object",
      "properties": {
        "outputs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "format": {
                "enum": [
                  "md",
                  "docx"
                ]
              },
              "path": {
                "$ref": "lawbench://contracts/common.schema.json#/$defs/rel_path"
              },
              "version": {
                "type": "integer",
                "minimum": 1
              }
            },
            "additionalProperties": false,
            "required": [
              "format",
              "path",
              "version"
            ]
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "outputs"
      ]
    }
  }
}
