{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lawbench://contracts/api/connection_test.schema.json",
  "title": "POST /api/connection/test",
  "description": "测试服务器连接（只发探测请求，不含内容）",
  "$defs": {
    "request": {
      "type": "object",
      "properties": {
        "server": {
          "enum": [
            "llm",
            "prep"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "server"
      ]
    },
    "response": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "ok": {
              "const": true
            },
            "value": {
              "type": "object",
              "properties": {
                "reachable": {
                  "type": "boolean"
                },
                "key_valid": {
                  "anyOf": [
                    {
                      "type": "boolean"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "latency_ms": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 0
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "message": {
                  "type": "string"
                }
              },
              "additionalProperties": false,
              "required": [
                "reachable",
                "key_valid",
                "latency_ms",
                "message"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "ok",
            "value"
          ]
        },
        {
          "$ref": "lawbench://contracts/common.schema.json#/$defs/fail"
        }
      ]
    },
    "value": {
      "type": "object",
      "properties": {
        "reachable": {
          "type": "boolean"
        },
        "key_valid": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "latency_ms": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "message": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "reachable",
        "key_valid",
        "latency_ms",
        "message"
      ]
    }
  }
}
