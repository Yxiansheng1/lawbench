{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lawbench://contracts/api/task_create.schema.json",
  "title": "POST /api/task",
  "description": "为某个会话写待执行的任务单；Agent 插件在该会话下一次请求时取用",
  "$defs": {
    "request": {
      "type": "object",
      "properties": {
        "case_id": {
          "$ref": "lawbench://contracts/common.schema.json#/$defs/case_id"
        },
        "session_id": {
          "$ref": "lawbench://contracts/common.schema.json#/$defs/session_id"
        },
        "entry": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "skill": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "inputs": {
          "type": "array",
          "items": {
            "$ref": "lawbench://contracts/common.schema.json#/$defs/rel_path"
          },
          "description": "选用的草稿或成果路径，服务端计算版本和 sha256"
        },
        "params": {
          "$ref": "lawbench://contracts/common.schema.json#/$defs/params"
        }
      },
      "additionalProperties": false,
      "required": [
        "case_id",
        "session_id",
        "entry",
        "skill",
        "inputs",
        "params"
      ]
    },
    "response": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "ok": {
              "const": true
            },
            "value": {
              "type": "object",
              "properties": {
                "task_id": {
                  "$ref": "lawbench://contracts/common.schema.json#/$defs/task_id"
                }
              },
              "additionalProperties": false,
              "required": [
                "task_id"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "ok",
            "value"
          ]
        },
        {
          "$ref": "lawbench://contracts/common.schema.json#/$defs/fail"
        }
      ]
    },
    "value": {
      "type": "object",
      "properties": {
        "task_id": {
          "$ref": "lawbench://contracts/common.schema.json#/$defs/task_id"
        }
      },
      "additionalProperties": false,
      "required": [
        "task_id"
      ]
    }
  }
}
