{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lawbench://contracts/files/outputs_index.schema.json",
  "title": "成果/索引.json",
  "description": "律师确认后的成果登记",
  "type": "object",
  "properties": {
    "v": {
      "const": 1
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "files": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "format": {
                  "enum": [
                    "md",
                    "docx"
                  ]
                },
                "path": {
                  "$ref": "lawbench://contracts/common.schema.json#/$defs/rel_path"
                }
              },
              "additionalProperties": false,
              "required": [
                "format",
                "path"
              ]
            },
            "minItems": 1
          },
          "task_id": {
            "$ref": "lawbench://contracts/common.schema.json#/$defs/task_id"
          },
          "inputs": {
            "type": "array",
            "items": {
              "$ref": "lawbench://contracts/common.schema.json#/$defs/input_ref"
            }
          },
          "citation_passed": {
            "type": "boolean"
          },
          "confirmed_at": {
            "$ref": "lawbench://contracts/common.schema.json#/$defs/time"
          },
          "draft": {
            "$ref": "lawbench://contracts/common.schema.json#/$defs/rel_path",
            "description": "这份成果来自哪份草稿（确认时写；1.4 起，旧记录没有）"
          }
        },
        "additionalProperties": false,
        "required": [
          "title",
          "version",
          "files",
          "task_id",
          "inputs",
          "citation_passed",
          "confirmed_at"
        ]
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "v",
    "outputs"
  ]
}
