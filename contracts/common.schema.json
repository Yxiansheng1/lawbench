{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lawbench://contracts/common.schema.json",
  "title": "通用定义",
  "description": "所有契约共用的类型；其他文件用 $ref 引用这里的 $defs",
  "$defs": {
    "case_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "description": "案件编号：UUID v4，首次打开案件时生成，写入 case.db 的 meta 表"
    },
    "material_id": {
      "type": "string",
      "pattern": "^M[0-9]{4}$",
      "description": "材料编号：M + 4 位序号，按首次导入顺序分配，同一案件内不复用；改名或移动视为删除后新增"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "小写十六进制 sha256"
    },
    "task_id": {
      "type": "string",
      "pattern": "^[TP]-[0-9]{14}-[0-9a-f]{4}$",
      "description": "任务编号：T-（Agent）或 P-（流水线）+ 本地时间 YYYYMMDDHHMMSS + - + 4 位小写十六进制"
    },
    "job_id": {
      "type": "string",
      "pattern": "^J-[0-9]{14}-[0-9a-f]{4}$",
      "description": "识别任务编号"
    },
    "session_id": {
      "type": "string",
      "minLength": 1,
      "description": "DSH 会话 ID，原样透传，不解析"
    },
    "time": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601，带时区，如 2026-09-28T09:30:00+08:00"
    },
    "abs_path": {
      "type": "string",
      "minLength": 3,
      "description": "本机绝对路径（仅界面与工作台服务之间使用，不进 AI 工具）"
    },
    "rel_path": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(^|/)\\.\\.(/|$)).+$",
      "description": "相对案件根目录的路径，分隔符一律用 /，不以 / 开头，不含 .. 段"
    },
    "material_type": {
      "enum": [
        "pdf",
        "docx",
        "doc",
        "wps",
        "xlsx",
        "xls",
        "csv",
        "md",
        "txt",
        "image"
      ]
    },
    "unit": {
      "enum": [
        "page",
        "para",
        "cell",
        "line"
      ],
      "description": "位置单位：PDF / 图片按页，Word 按段，Excel 按单元格，csv / md / txt 按行"
    },
    "material_status": {
      "enum": [
        "parsed",
        "needs_ocr",
        "ocr_running",
        "partial",
        "failed",
        "source_deleted"
      ],
      "description": "parsed=已解析可读；needs_ocr=有页待识别；ocr_running=识别中；partial=部分页识别失败或未识别；failed=无法处理；source_deleted=原件已删除（保留文本）"
    },
    "ocr_state": {
      "enum": [
        "none",
        "partial",
        "full"
      ],
      "description": "文本中识别所得的比例"
    },
    "error_code": {
      "enum": [
        "INVALID_ARGUMENT",
        "OUT_OF_CASE",
        "CASE_NOT_FOUND",
        "CASE_ROOT_IS_LINK",
        "CASE_IN_SYNC_FOLDER",
        "MATERIAL_NOT_FOUND",
        "MATERIAL_NOT_READY",
        "TASK_NOT_FOUND",
        "INPUT_CHANGED",
        "BUDGET_EXCEEDED",
        "SERVER_UNREACHABLE",
        "KEY_INVALID",
        "SERVER_BUSY",
        "CONTEXT_TOO_LONG",
        "OUTPUT_TRUNCATED",
        "TIMEOUT",
        "HOST_NOT_ALLOWED",
        "PREP_UNAVAILABLE",
        "CANCELLED",
        "SERVICE_UNAVAILABLE",
        "INTERNAL",
        "OFFICE_DIR_NOT_SET",
        "CONVERTER_UNAVAILABLE",
        "TEMPLATE_MISSING",
        "ENGINE_FAILED",
        "PLAN_NOT_CONFIRMED"
      ],
      "description": "错误码；含义与对应的中文提示见 Spec 20.1"
    },
    "error": {
      "type": "object",
      "properties": {
        "code": {
          "$ref": "lawbench://contracts/common.schema.json#/$defs/error_code"
        },
        "message": {
          "type": "string",
          "description": "给律师看的中文提示；不含材料名、检索词、正文"
        }
      },
      "additionalProperties": false,
      "required": [
        "code",
        "message"
      ]
    },
    "fail": {
      "type": "object",
      "properties": {
        "ok": {
          "const": false
        },
        "error": {
          "$ref": "lawbench://contracts/common.schema.json#/$defs/error"
        }
      },
      "additionalProperties": false,
      "required": [
        "ok",
        "error"
      ],
      "description": "统一失败体"
    },
    "loc": {
      "description": "结构化位置。page/para/line 用 from/to（含两端，to 可省略表示单个）；cell 用 sheet + ref（如 B12 或 B12:D12）",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "unit": {
              "enum": [
                "page",
                "para",
                "line"
              ]
            },
            "from": {
              "type": "integer",
              "minimum": 1
            },
            "to": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": false,
          "required": [
            "unit",
            "from"
          ]
        },
        {
          "type": "object",
          "properties": {
            "unit": {
              "const": "cell"
            },
            "sheet": {
              "type": "string",
              "minLength": 1
            },
            "ref": {
              "type": "string",
              "pattern": "^[A-Z]{1,3}[0-9]+(:[A-Z]{1,3}[0-9]+)?$"
            }
          },
          "additionalProperties": false,
          "required": [
            "unit",
            "sheet",
            "ref"
          ]
        }
      ]
    },
    "citation_text": {
      "type": "string",
      "pattern": "^〔(未找到依据|推断|[^〔〕、 ]+ (第[0-9]+(-[0-9]+)?[页段行]|[^〔〕、!]+![A-Z]{1,3}[0-9]+(:[A-Z]{1,3}[0-9]+)?)(、[^〔〕、 ]+ (第[0-9]+(-[0-9]+)?[页段行]|[^〔〕、!]+![A-Z]{1,3}[0-9]+(:[A-Z]{1,3}[0-9]+)?))*)〕$",
      "description": "出处文本写法：〔材料名 位置〕。位置为 第N页 / 第N-M页 / 第N段 / 第N-M段 / 第N行 / 第N-M行 / 工作表名!B12 / 工作表名!B12:D12；同一括号内多处用顿号分隔，每处都写材料名；另有 〔未找到依据〕、〔推断〕 两种固定写法"
    },
    "citation": {
      "type": "object",
      "properties": {
        "material_id": {
          "$ref": "lawbench://contracts/common.schema.json#/$defs/material_id"
        },
        "material_version": {
          "$ref": "lawbench://contracts/common.schema.json#/$defs/sha256"
        },
        "name": {
          "type": "string",
          "description": "材料名，与 case_list_materials 返回的 name 相同"
        },
        "loc": {
          "$ref": "lawbench://contracts/common.schema.json#/$defs/loc"
        }
      },
      "additionalProperties": false,
      "required": [
        "material_id",
        "material_version",
        "name",
        "loc"
      ],
      "description": "解析后的出处，由程序从出处文本解析得出并写入结果清单"
    },
    "thinking": {
      "enum": [
        "关闭",
        "低",
        "中",
        "高"
      ]
    },
    "window": {
      "enum": [
        "32K",
        "64K",
        "128K"
      ]
    },
    "params": {
      "type": "object",
      "properties": {
        "thinking": {
          "$ref": "lawbench://contracts/common.schema.json#/$defs/thinking"
        },
        "window": {
          "$ref": "lawbench://contracts/common.schema.json#/$defs/window"
        },
        "max_tokens": {
          "type": "integer",
          "minimum": 256,
          "maximum": 262144
        },
        "temperature": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        }
      },
      "additionalProperties": false,
      "required": [
        "thinking",
        "window",
        "max_tokens"
      ]
    },
    "budget": {
      "type": "object",
      "properties": {
        "model_calls": {
          "type": "integer",
          "minimum": 1
        },
        "tool_calls": {
          "type": "integer",
          "minimum": 1
        },
        "minutes": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "model_calls",
        "tool_calls",
        "minutes"
      ]
    },
    "problem": {
      "type": "object",
      "properties": {
        "class": {
          "enum": [
            "A",
            "B",
            "C",
            "D",
            "E",
            "F",
            "G"
          ],
          "description": "Spec 9.4 的七类问题"
        },
        "severity": {
          "enum": [
            "must_fix",
            "hint"
          ]
        },
        "excerpt": {
          "type": "string",
          "description": "出问题的原句，最多 120 字"
        },
        "citation": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "message": {
          "type": "string",
          "description": "中文说明，告诉模型或律师怎么改"
        }
      },
      "additionalProperties": false,
      "required": [
        "class",
        "severity",
        "excerpt",
        "message"
      ]
    },
    "citation_check": {
      "type": "object",
      "properties": {
        "passed": {
          "type": "boolean",
          "description": "没有 must_fix 类问题即为 true"
        },
        "problems": {
          "type": "array",
          "items": {
            "$ref": "lawbench://contracts/common.schema.json#/$defs/problem"
          }
        },
        "stats": {
          "type": "object",
          "properties": {
            "citations": {
              "type": "integer",
              "minimum": 0
            },
            "must_fix": {
              "type": "integer",
              "minimum": 0
            },
            "hints": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false,
          "required": [
            "citations",
            "must_fix",
            "hints"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "passed",
        "problems",
        "stats"
      ],
      "description": "出处核对结果（界面上叫'数值与出处位置核对'）"
    },
    "coverage": {
      "type": "object",
      "properties": {
        "total": {
          "type": "integer",
          "minimum": 0,
          "description": "本任务范围内的材料数"
        },
        "fully_read": {
          "type": "array",
          "items": {
            "type": "string",
            "description": "材料名"
          }
        },
        "partially_read": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "read_units": {
                "type": "integer",
                "minimum": 0
              },
              "total_units": {
                "type": "integer",
                "minimum": 0
              }
            },
            "additionalProperties": false,
            "required": [
              "name",
              "read_units",
              "total_units"
            ]
          }
        },
        "not_read": {
          "type": "array",
          "items": {
            "type": "string",
            "description": "材料名"
          }
        },
        "unreadable": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "reason": {
                "type": "string"
              }
            },
            "additionalProperties": false,
            "required": [
              "name",
              "reason"
            ]
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "total",
        "fully_read",
        "partially_read",
        "not_read",
        "unreadable"
      ],
      "description": "覆盖清单：按 reads.json 的实际读取记录计算，不采信模型自报"
    },
    "input_ref": {
      "type": "object",
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 1
        },
        "title": {
          "type": "string"
        },
        "path": {
          "$ref": "lawbench://contracts/common.schema.json#/$defs/rel_path"
        },
        "version": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "sha256": {
          "$ref": "lawbench://contracts/common.schema.json#/$defs/sha256"
        }
      },
      "additionalProperties": false,
      "required": [
        "index",
        "title",
        "path",
        "version",
        "sha256"
      ],
      "description": "任务选用的一份前序成果或草稿；执行时核对 sha256，不一致报 INPUT_CHANGED"
    },
    "fact": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^F[0-9]{4}$"
        },
        "text": {
          "type": "string"
        },
        "citations": {
          "type": "array",
          "items": {
            "$ref": "lawbench://contracts/common.schema.json#/$defs/citation_text"
          }
        },
        "status": {
          "enum": [
            "lawyer_confirmed",
            "excerpt",
            "unconfirmed"
          ],
          "description": "✔律师确认 > 原文摘录 > ⚠模型生成未确认"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "text",
        "citations",
        "status"
      ]
    },
    "material_row": {
      "type": "object",
      "properties": {
        "material_id": {
          "$ref": "lawbench://contracts/common.schema.json#/$defs/material_id"
        },
        "name": {
          "type": "string",
          "description": "案件内唯一，规则见 Spec 20.2"
        },
        "type": {
          "$ref": "lawbench://contracts/common.schema.json#/$defs/material_type"
        },
        "status": {
          "$ref": "lawbench://contracts/common.schema.json#/$defs/material_status"
        },
        "unit": {
          "$ref": "lawbench://contracts/common.schema.json#/$defs/unit"
        },
        "unit_count": {
          "type": "integer",
          "minimum": 0,
          "description": "位置单位的数量；unit 为 cell 时是工作表的个数（1.2 写明）"
        },
        "is_ocr": {
          "$ref": "lawbench://contracts/common.schema.json#/$defs/ocr_state"
        },
        "stale_ocr": {
          "type": "boolean",
          "description": "原件变了而识别结果还是旧版本"
        },
        "error": {
          "anyOf": [
            {
              "type": "string",
              "description": "失败原因，中文"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "material_id",
        "name",
        "type",
        "status",
        "unit",
        "unit_count",
        "is_ocr",
        "stale_ocr",
        "error"
      ],
      "description": "材料在 AI 工具中暴露的字段（不含路径）"
    }
  }
}
