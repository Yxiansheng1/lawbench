{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lawbench://contracts/core/tool.schema.json",
  "title": "POST /core/tool",
  "description": "执行一个 case_* 工具；args 和 value 的结构见 tools/<工具名>.schema.json",
  "$defs": {
    "request": {
      "type": "object",
      "properties": {
        "task_id": {
          "$ref": "lawbench://contracts/common.schema.json#/$defs/task_id"
        },
        "tool": {
          "type": "string",
          "pattern": "^case_[a-z_]+$"
        },
        "args": {
          "type": "object"
        }
      },
      "additionalProperties": false,
      "required": [
        "task_id",
        "tool",
        "args"
      ]
    },
    "response": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "ok": {
              "const": true
            },
            "value": {
              "type": "object"
            }
          },
          "additionalProperties": false,
          "required": [
            "ok",
            "value"
          ]
        },
        {
          "$ref": "lawbench://contracts/common.schema.json#/$defs/fail"
        }
      ]
    },
    "value": {
      "type": "object"
    }
  }
}
