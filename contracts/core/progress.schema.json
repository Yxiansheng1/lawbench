{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lawbench://contracts/core/progress.schema.json",
  "title": "POST /core/progress",
  "description": "session/event 收到 assistant/message 时调用：覆盖写 草稿/进行中.md，更新用量",
  "$defs": {
    "request": {
      "type": "object",
      "properties": {
        "task_id": {
          "$ref": "lawbench://contracts/common.schema.json#/$defs/task_id"
        },
        "text": {
          "type": "string"
        },
        "model_calls": {
          "type": "integer",
          "minimum": 0
        },
        "tool_calls": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "task_id",
        "text",
        "model_calls",
        "tool_calls"
      ]
    },
    "response": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "ok": {
              "const": true
            },
            "value": {
              "type": "object",
              "properties": {},
              "additionalProperties": false,
              "required": []
            }
          },
          "additionalProperties": false,
          "required": [
            "ok",
            "value"
          ]
        },
        {
          "$ref": "lawbench://contracts/common.schema.json#/$defs/fail"
        }
      ]
    },
    "value": {
      "type": "object",
      "properties": {},
      "additionalProperties": false,
      "required": []
    }
  }
}
