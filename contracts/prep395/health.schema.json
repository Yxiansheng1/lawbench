{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lawbench://contracts/prep395/health.schema.json",
  "title": "GET /health（395）",
  "description": "不需要 Key，不含任何内容",
  "type": "object",
  "properties": {
    "status": {
      "enum": [
        "ok",
        "degraded"
      ]
    },
    "ocr": {
      "enum": [
        "ok",
        "down"
      ]
    },
    "llm9b": {
      "enum": [
        "ok",
        "down"
      ]
    },
    "queue": {
      "type": "integer",
      "minimum": 0
    },
    "version": {
      "type": "string"
    },
    "contract_version": {
      "type": "string"
    },
    "ocr_model": {
      "type": "string",
      "description": "当前识别模型（模板）名，如 xiaomi-ocr-0（1.4 起，可选）"
    }
  },
  "additionalProperties": false,
  "required": [
    "status",
    "ocr",
    "llm9b",
    "queue",
    "version",
    "contract_version"
  ]
}
