diff --git a/packages/client/ui-workspace/src/client/lawbench-adopter.ts b/packages/client/ui-workspace/src/client/lawbench-adopter.ts
new file mode 100644
index 0000000000..f53743aabd
--- /dev/null
+++ b/packages/client/ui-workspace/src/client/lawbench-adopter.ts
@@ -0,0 +1,28 @@
+/**
+ * lawbench P-24: one hand-over point for "add workspace" (sidebar "+", Ctrl+O, the picker menu's add entry).
+ *
+ * A lawbench case is a workspace that the workbench service has registered. Attaching a picked directory straight
+ * as a workspace skips that registration, and the next new conversation there is refused. So when the lawbench
+ * client plugin has set an adopter, the picked directory is handed to it instead of being created as a workspace
+ * here; the adopter registers the case (or declines) and opens it itself. Without an adopter the original
+ * behaviour stays.
+ */
+export type LawbenchDirectoryAdopter = (path: string) => Promise<void>
+
+let adopter: LawbenchDirectoryAdopter | undefined
+
+/**
+ * Set or clear the adopter.
+ * @param next - the adopter, or undefined to restore the original add-workspace behaviour.
+ */
+export function setLawbenchDirectoryAdopter(next: LawbenchDirectoryAdopter | undefined): void {
+  adopter = next
+}
+
+/**
+ * The adopter in force.
+ * @returns the adopter, or undefined when none is set.
+ */
+export function lawbenchDirectoryAdopter(): LawbenchDirectoryAdopter | undefined {
+  return adopter
+}
