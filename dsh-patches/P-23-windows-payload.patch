diff --git a/apps/desktop/tests/lawbench-welcome-retry.client.spec.tsx b/apps/desktop/tests/lawbench-welcome-retry.client.spec.tsx
new file mode 100644
index 0000000000..615ee1de37
--- /dev/null
+++ b/apps/desktop/tests/lawbench-welcome-retry.client.spec.tsx
@@ -0,0 +1,98 @@
+// @vitest-environment jsdom
+// lawbench（令 1556 第 2 条）：首次配置页读不到设置时每 3 秒再读；服务起来就填好地址，Host 说出起不来的原因
+// （"本机服务未能启动：…"）就停在原因上，最多读 5 分钟。
+import { act } from 'react'
+import { createRoot } from 'react-dom/client'
+import { afterEach, beforeEach, expect, it, vi } from 'vitest'
+import { SETUP_READ_FAILED, Welcome } from '../src/client/WelcomePage.tsx'
+import type { WelcomeApi } from '../src/welcome-api.ts'
+
+const WHY = '本机服务未能启动：本机 18765 端口被其他程序占用，请关闭占用程序后重试'
+const NOT_YET = { ok: false, message: '工作台服务未启动，请稍后重试' }
+const servers = { llm_base_url: 'http://192.168.8.77:8000/v1', prep_base_url: 'http://192.168.8.124:9000' }
+let box: HTMLDivElement
+let root: ReturnType<typeof createRoot>
+
+beforeEach(() => {
+  vi.useFakeTimers()
+  ;(globalThis as { IS_REACT_ACT_ENVIRONMENT?: boolean }).IS_REACT_ACT_ENVIRONMENT = true
+  box = document.createElement('div')
+  document.body.append(box)
+  root = createRoot(box)
+})
+
+afterEach(() => {
+  act(() => { root.unmount() })
+  box.remove()
+  vi.useRealTimers()
+})
+
+const flush = async (ms = 0): Promise<void> => { await act(async () => { await vi.advanceTimersByTimeAsync(ms) }) }
+const render = (getSetup: () => Promise<unknown>): void => { act(() => { root.render(<Welcome api={{ id: 'zh-CN', getSetup } as unknown as WelcomeApi} />) }) }
+
+it('服务还在起：每 3 秒再读，起来了就填好地址、提示消失，之后不再读', async () => {
+  const answers: unknown[] = [NOT_YET, NOT_YET, { ok: true, value: { servers, hasKey: true, lawyerName: null } }]
+  const getSetup = vi.fn(async () => answers.length > 1 ? answers.shift() : answers[0])
+  render(getSetup)
+  await flush()
+  expect(box.textContent).toContain('工作台服务未启动')
+  await flush(6000)
+  expect(getSetup).toHaveBeenCalledTimes(3)
+  expect(box.textContent).not.toContain('工作台服务未启动')
+  expect((box.querySelector('input[name=llm], #llm') as HTMLInputElement | null)?.value).toBe(servers.llm_base_url)
+  await flush(30_000)
+  expect(getSetup).toHaveBeenCalledTimes(3)
+})
+
+it('Host 判定起不来要一分多钟：读到原因前一直读，读到原因就停在原因上', async () => {
+  let calls = 0
+  const getSetup = vi.fn(async () => (++calls <= 26 ? NOT_YET : { ok: false, message: WHY })) // 第 27 次（约 78 秒）才有原因
+  render(getSetup)
+  await flush(120_000)
+  expect(getSetup).toHaveBeenCalledTimes(27)
+  expect(box.textContent).toContain(WHY)
+})
+
+it('重读期间表单不可填，读到了才放开，不会盖掉律师已填的内容（复核 rv-A50 P3-1）', async () => {
+  const answers: unknown[] = [NOT_YET, { ok: true, value: { servers, hasKey: true, lawyerName: null } }]
+  render(vi.fn(async () => answers.length > 1 ? answers.shift() : answers[0]))
+  await flush()
+  const lawyer = (): HTMLInputElement => box.querySelector('#lawyer') as HTMLInputElement
+  const llm = (): HTMLInputElement => box.querySelector('#llm') as HTMLInputElement
+  expect(lawyer().disabled).toBe(true)
+  expect(llm().disabled).toBe(true)
+  expect([...box.querySelectorAll('button')].every((b) => b.disabled)).toBe(true)
+  await flush(3000)
+  expect(lawyer().disabled).toBe(false)
+  expect(llm().value).toBe(servers.llm_base_url)
+})
+
+it('读到原因（起不来）时放开表单，停在原因上', async () => {
+  render(vi.fn(async () => ({ ok: false, message: WHY })))
+  await flush()
+  expect((box.querySelector('#lawyer') as HTMLInputElement).disabled).toBe(false)
+  expect(box.textContent).toContain(WHY)
+})
+
+it('一直只说"未启动"：最多读 100 次（约 5 分钟），读满后放开表单、停在"未启动"，不再读', async () => {
+  const getSetup = vi.fn(async () => NOT_YET)
+  render(getSetup)
+  await flush(3000 * 98)
+  expect(getSetup).toHaveBeenCalledTimes(99)
+  expect((box.querySelector('#lawyer') as HTMLInputElement).disabled).toBe(true) // 还在读：不可填
+  await flush(3000)
+  expect(getSetup).toHaveBeenCalledTimes(100)
+  // 复核 rv-A51 NOTE：读满后的状态也要断言
+  expect((box.querySelector('#lawyer') as HTMLInputElement).disabled).toBe(false)
+  expect(box.textContent).toContain('工作台服务未启动')
+  await flush(60_000)
+  expect(getSetup).toHaveBeenCalledTimes(100)
+})
+
+it('getSetup 本身抛错：放开表单，显示通用说法（复核 rv-A51 NOTE）', async () => {
+  render(vi.fn(async () => { throw new Error('preload bridge gone') }))
+  await flush()
+  expect((box.querySelector('#lawyer') as HTMLInputElement).disabled).toBe(false)
+  expect(box.textContent).toContain(SETUP_READ_FAILED)
+  expect(box.textContent).not.toContain('preload')
+})
