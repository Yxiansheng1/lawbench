@@ -0,0 +1,53 @@
+import { readFileSync } from 'node:fs'
+import { join } from 'node:path'
+import { describe, expect, it } from 'vitest'
+import { lawbenchOmitOfficeEngine, lawbenchOmitPrimaryRuntime } from '../scripts/lawbench-product.mjs'
+
+// lawbench P-23（令 1337 第 1、8 条）：Windows 包不带 DSH 自己的 LibreOffice 原生引擎（libreoffice-kit-win32-x64，约 182 MB）
+// 和 primary-runtime（python-build-standalone，约 8500 个未签名文件）——lawbench 不挂 DSH 的 Office 组合（P-12），
+// 这两样运行时用不到；文书转换走工作台服务自己的 LibreOffice（tools\）。
+
+const base = {
+  DSH_DESKTOP_APP_ID: 'cn.lianyue.lawbench',
+  DSH_DESKTOP_MANDATORY_UPDATE_TEST_ORIGIN: 'https://policy.example.com',
+  DSH_DESKTOP_MANDATORY_UPDATE_CONFIG: JSON.stringify({ allowedAuthOrigins: ['https://login.example.com'] }),
+  DSH_DESKTOP_TARGET_PLATFORM: 'win32',
+  DSH_DESKTOP_TARGET_ARCH: 'x64',
+  DSH_DESKTOP_UNSIGNED: '1',
+}
+
+describe('Windows 包的 DSH 载荷（lawbench P-23）', () => {
+  it('不带原生 LibreOffice 引擎：Windows 一律不带；Mac 只有 ad-hoc 构建不带（T28 原样）', () => {
+    expect(lawbenchOmitOfficeEngine('win32', {})).toBe(true)
+    expect(lawbenchOmitOfficeEngine('darwin', {})).toBe(false)
+    expect(lawbenchOmitOfficeEngine('darwin', { LAWBENCH_MAC_ADHOC: '1' })).toBe(true)
+    expect(lawbenchOmitOfficeEngine('linux', {})).toBe(false)
+  })
+
+  it('不带 primary-runtime：只 Windows', () => {
+    expect(lawbenchOmitPrimaryRuntime('win32')).toBe(true)
+    expect(lawbenchOmitPrimaryRuntime('darwin')).toBe(false)
+  })
+
+  it('electron-builder：Windows 的 resources\\runtime 过滤掉 primary-runtime；Mac 照旧整目录', async () => {
+    const { createElectronBuilderConfig } = await import('../scripts/electron-builder-config.mjs')
+    type Res = { readonly extraResources: ReadonlyArray<{ readonly from: string; readonly to: string; readonly filter?: readonly string[] }> }
+    const win = (createElectronBuilderConfig(base, 'win32', 'x64') as Res).extraResources.find((r) => r.to === 'runtime')
+    expect(win?.filter).toEqual(['**/*', '!primary-runtime', '!primary-runtime/**'])
+  })
+
+  it('prepare-dsh 与 beforePack 走同一个判断（运行时清单、引擎在不在的自检、asar 外放三处一致）', () => {
+    const prepare = readFileSync(join(__dirname, '..', 'scripts', 'prepare-dsh.ts'), 'utf8')
+    expect(prepare).toContain('const omitOfficeEngine = lawbenchOmitOfficeEngine(process.platform, process.env)')
+    expect(prepare).toContain('&& !(omitOfficeEngine && lawbenchOfficeEngineEntry(relative(modules, source), officeEngine))')
+    expect(prepare).toContain("if (!omitOfficeEngine && !existsSync(join(DSH_OUTPUT_ROOT, 'node_modules', '@deepseek-ai', `libreoffice-kit-${officeEngine}`, 'prebuilds.json')))")
+    const config = readFileSync(join(__dirname, '..', 'scripts', 'electron-builder-config.mjs'), 'utf8')
+    expect(config).toContain('const office = lawbenchOmitOfficeEngine(resolvedPlatform, env) ? [] : await officePackageDirectories(')
+  })
+
+  it('打包后的冒烟不再读 primary-runtime（Windows 包里没有它；它只用来生成 Office 输入，而 Office 检查本来就跳过）', () => {
+    const smoke = readFileSync(join(__dirname, '..', 'scripts', 'smoke-runtime.ts'), 'utf8')
+    expect(smoke).toContain('const officeInputs = !lawbenchOmitPrimaryRuntime(process.platform)')
+    expect(smoke).toMatch(/if \(officeInputs\) \{\s+const primary = join\(resourcesRuntime, 'primary-runtime'\)/)
+  })
+})
