diff --git a/apps/desktop/tests/lawbench-request-policy.spec.ts b/apps/desktop/tests/lawbench-request-policy.spec.ts
new file mode 100644
index 0000000000..066bd09c78
--- /dev/null
+++ b/apps/desktop/tests/lawbench-request-policy.spec.ts
@@ -0,0 +1,60 @@
+import { describe, expect, it } from 'vitest'
+import { readFileSync } from 'node:fs'
+import { dirname, join, resolve } from 'node:path'
+import { fileURLToPath, pathToFileURL } from 'node:url'
+import { lawbenchAppFileRoots, lawbenchRequestAllowed } from '../src/lawbench-request-policy.ts'
+
+const HOST = 'http://127.0.0.1:3080/?token=x'
+
+describe('lawbench P-9 request policy', () => {
+  it('allows application resources and local schemes', () => {
+    for (const url of ['dsh-app://app/index.html', 'dsh-app://shell/welcome.html', 'data:image/png;base64,AA==', 'blob:dsh-app://app/1', 'devtools://devtools/x', 'about:blank']) {
+      expect(lawbenchRequestAllowed(url, HOST), url).toBe(true)
+    }
+  })
+  it('file: only for the application renderer files (first-run window); other local files and shares refused', () => {
+    const app = join(process.cwd(), 'apps-desktop-fixture', 'renderer')
+    expect(lawbenchRequestAllowed(pathToFileURL(join(app, 'welcome.html')).href, HOST, app)).toBe(true)
+    expect(lawbenchRequestAllowed(pathToFileURL(join(app, 'assets', 'welcome.js')).href, HOST, app)).toBe(true)
+    for (const url of [
+      pathToFileURL(join(app, '..', 'secret.html')).href,
+      pathToFileURL(`${app}-other${join('/', 'x.html')}`).href,
+      'file:///C:/x.html',
+      'file://192.168.1.20/share/a.png',
+    ]) {
+      expect(lawbenchRequestAllowed(url, HOST, app), url).toBe(false)
+    }
+    expect(lawbenchRequestAllowed(pathToFileURL(join(app, 'welcome.html')).href, HOST)).toBe(false) // root unknown
+  })
+  it('T14: every local resource the real first-run page references loads; the rest of lib/ stays blocked', () => {
+    const appPath = resolve(dirname(fileURLToPath(import.meta.url)), '..')
+    const roots = lawbenchAppFileRoots(appPath)
+    const page = join(appPath, 'renderer', 'welcome.html')
+    const refs = [...readFileSync(page, 'utf8').matchAll(/(?:href|src)="([^"]+)"/g)].map((m) => m[1]!).filter((r) => !/^[a-z]+:/i.test(r))
+    expect(refs).toEqual(expect.arrayContaining(['../lib/welcome/brand-font.css', '../lib/welcome/welcome.css', '../lib/welcome/welcome.js']))
+    expect(lawbenchRequestAllowed(pathToFileURL(page).href, HOST, roots)).toBe(true)
+    for (const ref of refs) expect(lawbenchRequestAllowed(pathToFileURL(resolve(dirname(page), ref)).href, HOST, roots), ref).toBe(true)
+    for (const other of [join(appPath, 'lib', 'main.js'), join(appPath, 'lib', 'preload-app.cjs'), join(appPath, 'lib', 'welcome-x', 'a.js'), join(appPath, 'lib', 'welcome', '..', 'main.js'), join(appPath, 'package.json')]) {
+      expect(lawbenchRequestAllowed(pathToFileURL(other).href, HOST, roots), other).toBe(false)
+    }
+  })
+  it('refuses chrome: and chrome-extension: (no internal pages or extensions are used)', () => {
+    for (const url of ['chrome://gpu', 'chrome-extension://abc/x.js']) {
+      expect(lawbenchRequestAllowed(url, HOST), url).toBe(false)
+    }
+  })
+  it('allows only the Host itself over http and ws', () => {
+    expect(lawbenchRequestAllowed('http://127.0.0.1:3080/api/x', HOST)).toBe(true)
+    expect(lawbenchRequestAllowed('ws://127.0.0.1:3080/api/remote.mux', HOST)).toBe(true)
+    expect(lawbenchRequestAllowed('https://127.0.0.1:3080/api/x', HOST)).toBe(false)
+    expect(lawbenchRequestAllowed('http://127.0.0.1:3081/api/x', HOST)).toBe(false)
+    expect(lawbenchRequestAllowed('http://localhost:3080/api/x', HOST)).toBe(false)
+    expect(lawbenchRequestAllowed('http://user:pw@127.0.0.1:3080/api/x', HOST)).toBe(false)
+  })
+  it('cancels every other network request, including before the Host is known', () => {
+    for (const url of ['https://evil.test/a.png?q=secret', 'http://192.168.1.20:8000/img', 'wss://evil.test/s', 'ws://10.0.0.1/s', 'ftp://evil.test/x', 'not a url']) {
+      expect(lawbenchRequestAllowed(url, HOST), url).toBe(false)
+    }
+    expect(lawbenchRequestAllowed('http://127.0.0.1:3080/api/x', undefined)).toBe(false)
+  })
+})
