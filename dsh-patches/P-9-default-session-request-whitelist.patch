new file mode 100644
index 0000000000..fafb29cb94
--- /dev/null
+++ b/apps/desktop/src/lawbench-request-policy.ts
@@ -0,0 +1,60 @@
+/**
+ * lawbench P-9 (Spec 3.2, owner decision N38): the desktop default session may only reach the
+ * application's own resources and the local Host. Every other http, https, ws and wss request
+ * from any window on the default session is cancelled, so model answers cannot make the
+ * renderer fetch remote images, fonts, styles or scripts.
+ */
+
+import { fileURLToPath } from 'node:url'
+import { join, resolve, sep } from 'node:path'
+
+/**
+ * Non-network schemes the application itself uses, none of which leaves the machine:
+ * `dsh-app:` the bundled UI; `data:` / `blob:` inline and in-memory resources the renderer builds;
+ * `devtools:` the developer tools window; `about:` the `about:blank` a frame or window starts on.
+ * `chrome:` / `chrome-extension:` are not listed (no internal pages or extensions are used).
+ * `file:` is handled separately: only the application's own renderer files (the first-run window
+ * is loaded from there with `loadFile`) and the first-run window's bundle in `lib/welcome/`
+ * (`renderer/welcome.html` loads `../lib/welcome/welcome.js|css` and `brand-font.css`; T14 found
+ * them blocked), never other local files, the rest of `lib/`, or `file://host/share` (SMB).
+ */
+const LOCAL_SCHEMES = new Set(['dsh-app:', 'data:', 'blob:', 'devtools:', 'about:'])
+
+/**
+ * The directories whose files the default session may load over `file:` (the same layout in the
+ * development tree and in the packaged `app.asar`).
+ * @param appPath - `app.getAppPath()`.
+ * @returns the renderer directory and the first-run window's bundle directory, nothing else under `lib/`.
+ */
+export function lawbenchAppFileRoots(appPath: string): string[] {
+  return [join(appPath, 'renderer'), join(appPath, 'lib', 'welcome')]
+}
+
+/** Whether a `file:` URL names a local file inside one of the allowed application directories. */
+function appFile(target: URL, appFiles: string | readonly string[] | undefined): boolean {
+  if (appFiles === undefined || target.host !== '') return false
+  let path: string
+  try { path = resolve(fileURLToPath(target)) } catch { return false }
+  const fold = (p: string): string => (process.platform === 'win32' ? p.toLowerCase() : p)
+  return (typeof appFiles === 'string' ? [appFiles] : appFiles).some((dir) => fold(path).startsWith(fold(resolve(dir)) + sep))
+}
+const NETWORK_SCHEMES = new Set(['http:', 'https:', 'ws:', 'wss:'])
+
+/**
+ * Whether a default-session request may proceed.
+ * @param url - the request URL as Electron reports it.
+ * @param hostUrl - the local Host URL once known (only its exact host:port is allowed, over http or ws).
+ * @param appFiles - the allowed application directories (see `lawbenchAppFileRoots`); `file:` URLs are allowed only inside them.
+ * @returns true when the request stays inside the application or reaches the Host itself.
+ */
+export function lawbenchRequestAllowed(url: string, hostUrl: string | undefined, appFiles?: string | readonly string[]): boolean {
+  let target: URL
+  try { target = new URL(url) } catch { return false }
+  if (LOCAL_SCHEMES.has(target.protocol)) return true
+  if (target.protocol === 'file:') return appFile(target, appFiles)
+  if (!NETWORK_SCHEMES.has(target.protocol)) return false
+  if (hostUrl === undefined) return false
+  let host: URL
+  try { host = new URL(hostUrl) } catch { return false }
+  return (target.protocol === 'http:' || target.protocol === 'ws:') && target.host === host.host && target.username === '' && target.password === ''
+}
