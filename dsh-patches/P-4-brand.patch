diff --git a/apps/desktop/tests/lawbench-stage.spec.ts b/apps/desktop/tests/lawbench-stage.spec.ts
new file mode 100644
index 0000000000..7b2a28f01b
--- /dev/null
+++ b/apps/desktop/tests/lawbench-stage.spec.ts
@@ -0,0 +1,26 @@
+import { describe, expect, it } from 'vitest'
+
+// lawbench P-4（T20 步骤 3 第 4 条）：packaging\build.ps1 暂存的工作台载荷（python\、service\、skills\、engines\、tools\）
+// 经 LAWBENCH_STAGE_DIR 交给 electron-builder，以 extraFiles 放到 exe 旁边（Host 打包布局按这里找）；不给就不带。
+
+const base = {
+  DSH_DESKTOP_APP_ID: 'cn.lianyue.lawbench',
+  DSH_DESKTOP_MANDATORY_UPDATE_TEST_ORIGIN: 'https://policy.example.com',
+  DSH_DESKTOP_MANDATORY_UPDATE_CONFIG: JSON.stringify({ allowedAuthOrigins: ['https://login.example.com'] }),
+  DSH_DESKTOP_TARGET_PLATFORM: 'win32',
+  DSH_DESKTOP_TARGET_ARCH: 'x64',
+  DSH_DESKTOP_UNSIGNED: '1',
+}
+
+describe('打包带上工作台载荷（lawbench P-4）', () => {
+  it('给了 LAWBENCH_STAGE_DIR：整个目录放到安装目录根（exe 旁），requirements.txt 不带', async () => {
+    const { createElectronBuilderConfig } = await import('../scripts/electron-builder-config.mjs')
+    const config = createElectronBuilderConfig({ ...base, LAWBENCH_STAGE_DIR: 'D:\\build\\stage' }, 'win32', 'x64') as { extraFiles?: unknown }
+    expect(config.extraFiles).toEqual([{ from: 'D:\\build\\stage', to: '.', filter: ['**/*', '!requirements.txt'] }])
+  })
+  it('没给：不带（开发期、DSH 自己的打包测试照旧）', async () => {
+    const { createElectronBuilderConfig } = await import('../scripts/electron-builder-config.mjs')
+    const config = createElectronBuilderConfig(base, 'win32', 'x64') as { extraFiles?: unknown }
+    expect(config.extraFiles).toBeUndefined()
+  })
+})
