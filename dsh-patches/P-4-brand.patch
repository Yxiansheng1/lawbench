diff --git a/apps/desktop/src/lawbench-isolation.ts b/apps/desktop/src/lawbench-isolation.ts
new file mode 100644
index 0000000..3958344
--- /dev/null
+++ b/apps/desktop/src/lawbench-isolation.ts
@@ -0,0 +1,50 @@
+/**
+ * lawbench P-4 (order 1444): the installed lawyer workbench must not share state with an original DeepSeek Harness
+ * desktop on the same machine. Both packages are named "@deepseek-ai/dsh-desktop", so by default they share
+ * - Electron's userData (%APPDATA%\@deepseek-ai\dsh-desktop) and with it the single-instance lock: starting one while
+ *   the other runs only focuses the other;
+ * - the DSH home (~/.dsh) and its desktop profile (~/.dsh/profiles/desktop, with its lock): a profile created by the
+ *   original lacks the lawbench bundle, so P-14 refuses to start, and the original would load our bundle.
+ * - the Host's fixed web port 19387 (order 1539).
+ * Only the installed package (app.isPackaged) moves; development instances keep their paths and port.
+ */
+import { join } from 'node:path'
+
+/** The part of Electron's app this needs (replaceable in tests). */
+export interface IsolationApp {
+  readonly isPackaged: boolean
+  setPath(name: 'userData', path: string): void
+}
+
+/**
+ * Paths the installed lawyer workbench uses instead of the original DSH's.
+ * @param env - process environment (APPDATA, LOCALAPPDATA).
+ * @param packaged - whether this is the installed package.
+ * @returns userData and DSH home, or undefined in development (or without the Windows profile variables).
+ */
+export function lawbenchIsolatedPaths(env: NodeJS.ProcessEnv, packaged: boolean): { userData: string; dshHome: string } | undefined {
+  if (!packaged || !env.APPDATA || !env.LOCALAPPDATA) return undefined
+  return { userData: join(env.APPDATA, 'lawbench-desktop'), dshHome: join(env.LOCALAPPDATA, 'lawbench', 'dsh-home') }
+}
+
+/**
+ * Apply the isolation before anything reads userData or the DSH home (before the single-instance lock and
+ * resolveDesktopPaths). DSH_HOME is set in this process's environment, so the Host child process inherits it.
+ * @param application - Electron app.
+ * @param env - environment to read and update.
+ * @returns the applied paths, or undefined when nothing changed.
+ */
+export function applyLawbenchIsolation(application: IsolationApp, env: NodeJS.ProcessEnv = process.env): { userData: string; dshHome: string } | undefined {
+  const paths = lawbenchIsolatedPaths(env, application.isPackaged)
+  // Electron's app always has setPath; DSH's startup tests use a partial app double without it
+  if (paths === undefined || typeof application.setPath !== 'function') return undefined
+  application.setPath('userData', paths.userData)
+  env.DSH_HOME = paths.dshHome
+  // The Host's web server takes any free port (order 1539): a fixed 19387 fails with EADDRINUSE while an original
+  // DeepSeek Harness runs (now possible, the single-instance locks being separate). The main process reads the Host's
+  // actual URL from its ready message, so nothing else depends on the number.
+  env.LAWBENCH_HOST_PORT = '0'
+  // Marks the installed package for code that has no Electron app object at hand (directory-picker.ts, order 2043)
+  env.LAWBENCH_PACKAGED = '1'
+  return paths
+}
