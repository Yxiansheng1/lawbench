+import { readFileSync } from 'node:fs'
+import { join } from 'node:path'
+import { describe, expect, it } from 'vitest'
+import { applyLawbenchIsolation, lawbenchIsolatedPaths } from '../src/lawbench-isolation.ts'
+import { lawbenchDefaultFolder } from '../src/directory-picker.ts'
+
+// lawbench P-4（令 1444）：装好的律师工作台不与原版 DeepSeek Harness 共用 Electron 用户数据（连带单实例锁）和 DSH 主目录（~/.dsh 与 profile）。
+const ENV = { APPDATA: 'C:\\Users\\x\\AppData\\Roaming', LOCALAPPDATA: 'C:\\Users\\x\\AppData\\Local' }
+
+describe('与原版 DSH 隔离（lawbench P-4）', () => {
+  it('装好的包：userData 与 DSH_HOME 都换到我方目录，不是原版的 %APPDATA%\\@deepseek-ai\\dsh-desktop、~/.dsh', () => {
+    const set: Array<[string, string]> = []
+    const env: NodeJS.ProcessEnv = { ...ENV }
+    const r = applyLawbenchIsolation({ isPackaged: true, setPath: (n, p) => { set.push([n, p]) } }, env)
+    expect(r).toEqual({ userData: join(ENV.APPDATA, 'lawbench-desktop'), dshHome: join(ENV.LOCALAPPDATA, 'lawbench', 'dsh-home') })
+    expect(set).toEqual([['userData', join(ENV.APPDATA, 'lawbench-desktop')]])
+    expect(env.DSH_HOME).toBe(join(ENV.LOCALAPPDATA, 'lawbench', 'dsh-home'))
+    expect(env.DSH_HOME).not.toMatch(/\.dsh$/)
+    expect(env.LAWBENCH_HOST_PORT).toBe('0') // 令 1539：Host 不用写死的 19387
+    expect(env.LAWBENCH_PACKAGED).toBe('1') // 令 2043：选目录对话框据此从 <用户目录>\连越律师工作台 开始
+    expect(set[0]![1]).not.toMatch(/@deepseek-ai/)
+  })
+
+  it('开发期（未打包）不搬家：不改 userData、不设 DSH_HOME', () => {
+    const set: string[] = []
+    const env: NodeJS.ProcessEnv = { ...ENV }
+    expect(applyLawbenchIsolation({ isPackaged: false, setPath: (_n, p) => { set.push(p) } }, env)).toBeUndefined()
+    expect(set).toEqual([])
+    expect(env.DSH_HOME).toBeUndefined()
+    expect(env.LAWBENCH_HOST_PORT).toBeUndefined()
+    expect(lawbenchIsolatedPaths({}, true)).toBeUndefined()
+  })
+
+  it('main.ts 在单实例锁、日志路径和读路径之前就隔离（行首、未注释的调用；复核 F3）', () => {
+    const src = readFileSync(join(__dirname, '..', 'src', 'main.ts'), 'utf8')
+    const m = /^applyLawbenchIsolation\(app\)\s*$/m.exec(src)
+    expect(m).not.toBeNull()
+    const apply = m!.index
+    for (const later of [/^app\.setAppLogsPath\(\)/m, /^const ownsDesktopInstance = claimDesktopSingleInstance\(app/m, /^const recovery = new DesktopFatalRecovery/m]) {
+      const at = later.exec(src)
+      expect(at, String(later)).not.toBeNull()
+      expect(apply).toBeLessThan(at!.index)
+    }
+  })
+
+  it('Host 的端口：给了 LAWBENCH_HOST_PORT 就用它，开发期仍是 19387（复核 F1）', () => {
+    const host = readFileSync(join(__dirname, '..', '..', 'desktop-host', 'src', 'index.ts'), 'utf8')
+    expect(host).toMatch(/'--port', process\.env\.LAWBENCH_HOST_PORT \?\? '19387'/)
+  })
+
+  it('选目录对话框的起始位置（令 2043）：装好的包且 <用户目录>\\连越律师工作台 已在时从那里开始；开发期、文件夹不在时照旧', () => {
+    const home = String.raw`C:\Users\x`
+    expect(lawbenchDefaultFolder(true, home, () => true)).toBe(join(home, '连越律师工作台'))
+    expect(lawbenchDefaultFolder(true, home, () => false)).toBeUndefined()
+    expect(lawbenchDefaultFolder(false, home, () => true)).toBeUndefined()
+  })
+})
