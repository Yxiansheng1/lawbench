@@ -0,0 +1,48 @@
+// @vitest-environment jsdom
+import { act, renderHook } from '@testing-library/react'
+import { describe, expect, it, vi } from 'vitest'
+import { buildInlineMarks, chatInlineMarks, useChatInlineMarks, type ChatInlineMark } from '../src/client/inline-marks.ts'
+
+const citation = (open = vi.fn()): ChatInlineMark => ({
+  pattern: /〔([^〔〕]+)〕/u,
+  ranges: (match) => {
+    const inner = match.slice(1, -1)
+    if (inner === '推断') return []
+    const out: Array<[number, number]> = []
+    let at = 1
+    for (const item of inner.split('、')) { out.push([at, at + item.length]); at += item.length + 1 }
+    return out
+  },
+  label: text => `打开原文：${text}`,
+  open,
+})
+
+describe('lawbench P-16 chat inline marks', () => {
+  it('splits a run into text and clickable items, adding the g flag and skipping empty ranges', () => {
+    const open = vi.fn()
+    const parts = buildInlineMarks([citation(open)]).split('见〔甲 第1页、乙 第2页〕与〔推断〕')!
+    expect(parts.map(p => typeof p === 'string' ? p : `[${p.text}]`)).toEqual(['见〔', '[甲 第1页]', '、', '[乙 第2页]', '〕与〔推断〕'])
+    const second = parts[3] as { open: () => void; label: string }
+    expect(second.label).toBe('打开原文：乙 第2页')
+    second.open()
+    expect(open).toHaveBeenCalledWith('乙 第2页')
+    expect(buildInlineMarks([citation()]).split('没有出处')).toBeUndefined()
+  })
+
+  it('lets the earlier registration win where two marks overlap', () => {
+    const whole: ChatInlineMark = { pattern: /〔[^〕]+〕/u, label: t => t, open: vi.fn() }
+    const parts = buildInlineMarks([whole, citation()]).split('〔甲 第1页〕')!
+    expect(parts).toHaveLength(1)
+    expect((parts[0] as { text: string }).text).toBe('〔甲 第1页〕')
+  })
+
+  it('publishes registrations to renderers and withdraws them on dispose', () => {
+    const { result } = renderHook(() => useChatInlineMarks())
+    expect(result.current).toBeUndefined()
+    let dispose = (): void => {}
+    act(() => { dispose = chatInlineMarks.register(citation()) })
+    expect(result.current?.split('〔甲 第1页〕')).toHaveLength(3)
+    act(() => { dispose() })
+    expect(result.current).toBeUndefined()
+  })
+})
