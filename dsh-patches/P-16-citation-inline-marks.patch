@@ -0,0 +1,61 @@
+// @vitest-environment jsdom
+import { cleanup, fireEvent, render, screen } from '@testing-library/react'
+import { afterEach, expect, it, vi } from 'vitest'
+import type { MarkdownInlineMarks } from '../src/index.ts'
+import { MarkdownText } from './markdown-test-components.tsx'
+
+afterEach(() => { cleanup() })
+
+/** lawbench P-16: a toy owner that makes every 〔…〕 item clickable, one button per item. */
+function marks(open: (text: string) => void): MarkdownInlineMarks {
+  return {
+    split(value) {
+      const out: Array<string | { text: string; label: string; open: () => void }> = []
+      let cursor = 0
+      for (const m of value.matchAll(/〔([^〔〕]+)〕/gu)) {
+        out.push(value.slice(cursor, m.index + 1))
+        let at = m.index + 1
+        for (const [i, item] of m[1]!.split('、').entries()) {
+          if (i > 0) { out.push('、'); at += 1 }
+          out.push({ text: item, label: `打开原文：${item}`, open: () => { open(item) } })
+          at += item.length
+        }
+        out.push('〕')
+        cursor = at + 1
+      }
+      if (cursor === 0) return undefined
+      out.push(value.slice(cursor))
+      return out
+    },
+  }
+}
+
+it('draws owner marks in settled prose as focusable buttons that open their item', () => {
+  const open = vi.fn()
+  const inlineMarks = marks(open)
+  render(<MarkdownText text={'金额 30 万〔借款合同 第2页、流水!B12〕。'} inlineMarks={inlineMarks} />)
+  const first = screen.getByRole('button', { name: '打开原文：借款合同 第2页' })
+  expect(first.textContent).toBe('借款合同 第2页')
+  expect(first.tagName).toBe('BUTTON')
+  fireEvent.click(first)
+  fireEvent.click(screen.getByRole('button', { name: '打开原文：流水!B12' }))
+  expect(open.mock.calls).toEqual([['借款合同 第2页'], ['流水!B12']])
+  expect(document.body.textContent).toContain('金额 30 万〔借款合同 第2页、流水!B12〕。')
+})
+
+it('keeps streaming frames, link text and runs without marks as plain text', () => {
+  const inlineMarks = marks(vi.fn())
+  const view = render(<MarkdownText text={'见〔借款合同 第2页〕'} streaming inlineMarks={inlineMarks} />)
+  expect(screen.queryByRole('button', { name: /打开原文/ })).toBeNull()
+  view.rerender(<MarkdownText text={'[见〔借款合同 第2页〕](https://example.com)'} inlineMarks={inlineMarks} />)
+  expect(screen.queryByRole('button', { name: /打开原文/ })).toBeNull()
+  view.rerender(<MarkdownText text={'没有出处的一段话'} inlineMarks={inlineMarks} />)
+  expect(screen.queryByRole('button')).toBeNull()
+  view.rerender(<MarkdownText text={'见〔借款合同 第2页〕'} />)
+  expect(screen.queryByRole('button', { name: /打开原文/ })).toBeNull()
+})
+
+it('marks inside strong text still render, one text run at a time', () => {
+  render(<MarkdownText text={'**重点〔借款合同 第2页〕**'} inlineMarks={marks(vi.fn())} />)
+  expect(screen.getByRole('button', { name: '打开原文：借款合同 第2页' }).closest('strong')).not.toBeNull()
+})
