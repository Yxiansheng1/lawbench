index 0000000000..12429339a4
--- /dev/null
+++ b/packages/client/ui-chat/src/client/inline-marks.ts
@@ -0,0 +1,99 @@
+/**
+ * lawbench P-16: inline marks in settled assistant prose (for example source
+ * citations). A plugin registers only a pattern, the clickable ranges inside a
+ * match, a label and an open function — never HTML; the Markdown renderer draws
+ * the buttons, so they are real, focusable controls.
+ * @module @deepseek-ai/dsh-client-ui-chat/inline-marks
+ */
+
+import { useSyncExternalStore } from 'react'
+import type { MarkdownInlineMarks } from '@deepseek-ai/dsh-client-ui-primitives'
+
+/** One registered kind of inline mark. */
+export interface ChatInlineMark {
+  /** Finds marks in one prose text run; the `g` flag is added when missing. */
+  readonly pattern: RegExp
+  /**
+   * Clickable ranges inside one match, as [start, end) offsets relative to the match.
+   * Omitted: the whole match is one button. Empty: the match stays plain text.
+   */
+  readonly ranges?: (match: string) => ReadonlyArray<readonly [number, number]>
+  /** Accessible label and tooltip for one clickable text. */
+  readonly label: (text: string) => string
+  /** Open whatever the clickable text names. */
+  readonly open: (text: string) => void
+}
+
+/** The `chatInlineMarks` service. */
+export interface ChatInlineMarks {
+  /**
+   * Register one kind of mark for assistant prose.
+   * @param mark - Pattern, ranges, label and opener.
+   * @returns Disposer removing the registration.
+   */
+  register(mark: ChatInlineMark): () => void
+}
+
+const marks = new Set<ChatInlineMark>()
+const listeners = new Set<() => void>()
+let snapshot: MarkdownInlineMarks | undefined
+
+function publish(): void {
+  snapshot = marks.size === 0 ? undefined : buildInlineMarks([...marks])
+  for (const listener of listeners) listener()
+}
+
+/** The process-wide registry behind the `chatInlineMarks` service. */
+export const chatInlineMarks: ChatInlineMarks = {
+  register(mark) {
+    marks.add(mark)
+    publish()
+    return () => { if (marks.delete(mark)) publish() }
+  },
+}
+
+/**
+ * Turn registered marks into the renderer's split function.
+ * @param registered - Marks in registration order; earlier marks win on overlap.
+ * @returns The renderer vocabulary.
+ */
+export function buildInlineMarks(registered: readonly ChatInlineMark[]): MarkdownInlineMarks {
+  return {
+    split(value) {
+      const spans: Array<{ start: number; end: number; mark: ChatInlineMark }> = []
+      for (const mark of registered) {
+        const pattern = new RegExp(mark.pattern.source, mark.pattern.flags.includes('g') ? mark.pattern.flags : `${mark.pattern.flags}g`)
+        for (const match of value.matchAll(pattern)) {
+          const at = match.index
+          const ranges = mark.ranges?.(match[0]) ?? [[0, match[0].length] as const]
+          for (const [from, to] of ranges) {
+            const start = at + from
+            const end = at + to
+            if (to <= from || spans.some(s => start < s.end && end > s.start)) continue
+            spans.push({ start, end, mark })
+          }
+        }
+      }
+      if (spans.length === 0) return undefined
+      spans.sort((a, b) => a.start - b.start)
+      const out: Array<string | { text: string; label: string; open: () => void }> = []
+      let cursor = 0
+      for (const { start, end, mark } of spans) {
+        if (start > cursor) out.push(value.slice(cursor, start))
+        const text = value.slice(start, end)
+        out.push({ text, label: mark.label(text), open: () => { mark.open(text) } })
+        cursor = end
+      }
+      if (cursor < value.length) out.push(value.slice(cursor))
+      return out
+    },
+  }
+}
+
+/** Current renderer vocabulary; undefined while no plugin registered a mark. */
+export function useChatInlineMarks(): MarkdownInlineMarks | undefined {
+  return useSyncExternalStore(
+    (listener) => { listeners.add(listener); return () => { listeners.delete(listener) } },
+    () => snapshot,
+  )
+}
