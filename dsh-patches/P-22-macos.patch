+ * materialized Mach-O file gets an ad-hoc signature before the runtime inventory is sealed, so the packaged
+ * app.asar.unpacked matches the inventory byte for byte (packaging/mac/sign-adhoc.sh leaves it alone afterwards).
+ * Single files only: no bundle is signed, no file is added.
+ * @param root - Self-contained production runtime without symlinks.
+ * @returns Number of signed native files.
+ */
+export async function lawbenchAdhocSignRuntime(root: string): Promise<number> {
+  const files = inventoryDesktopRuntime(root).map(file => file.path).filter(path => MACH_O_MAGICS.has(magic(join(root, path))))
+  for (const path of files) {
+    await promisify(execFile)('/usr/bin/codesign', ['--force', '--sign', '-', '--timestamp=none', join(root, path)])
+  }
+  return files.length
+}
