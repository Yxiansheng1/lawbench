diff --git a/apps/desktop/tests/lawbench-macos.spec.ts b/apps/desktop/tests/lawbench-macos.spec.ts
new file mode 100644
index 0000000000..9b1c386d18
--- /dev/null
+++ b/apps/desktop/tests/lawbench-macos.spec.ts
@@ -0,0 +1,74 @@
+import { describe, expect, it } from 'vitest'
+import { lawbenchIsolatedPaths } from '../src/lawbench-isolation.ts'
+
+// lawbench T28（令 1424）：macOS 版第一阶段——隔离目录、ad-hoc 打包开关、载荷放进 Contents/Resources、dmg 里并排放小工具。
+// Windows 的原有行为由 lawbench-isolation / lawbench-stage 等原用例守着。
+
+const base = {
+  DSH_DESKTOP_APP_ID: 'cn.lianyue.lawbench',
+  DSH_DESKTOP_MANDATORY_UPDATE_TEST_ORIGIN: 'https://policy.example.com',
+  DSH_DESKTOP_MANDATORY_UPDATE_CONFIG: JSON.stringify({ allowedAuthOrigins: ['https://login.example.com'] }),
+  DSH_DESKTOP_TARGET_PLATFORM: 'darwin',
+  DSH_DESKTOP_TARGET_ARCH: 'arm64',
+  LAWBENCH_MAC_ADHOC: '1',
+}
+type MacConfig = {
+  mac: { identity?: string | null; forceCodeSigning?: boolean; hardenedRuntime?: boolean; notarize?: boolean; target?: unknown }
+  dmg: { sign?: boolean; contents?: unknown }
+  extraResources: Array<{ from: string; to: string; filter?: string[] }>
+  extraFiles?: unknown
+}
+
+describe('macOS 隔离目录（T28）', () => {
+  it('装好的 Mac 包：userData 与 DSH_HOME 进 ~/Library/Application Support 下我方目录', () => {
+    expect(lawbenchIsolatedPaths({}, true, 'darwin', '/Users/x')).toEqual({
+      userData: '/Users/x/Library/Application Support/lawbench-desktop',
+      dshHome: '/Users/x/Library/Application Support/lawbench/dsh-home',
+    })
+  })
+  it('开发期不搬家；Windows 缺变量时照旧不搬', () => {
+    expect(lawbenchIsolatedPaths({}, false, 'darwin', '/Users/x')).toBeUndefined()
+    expect(lawbenchIsolatedPaths({}, true, 'win32', 'C:\\Users\\x')).toBeUndefined()
+  })
+})
+
+// 第一次导入打包配置模块较慢（与其他打包用例并发时超过默认 5 秒）
+describe('ad-hoc 打包开关（T28，令 1424 第 3 条）', { timeout: 60_000 }, () => {
+  it('LAWBENCH_MAC_ADHOC=1：不要签名身份与公证凭据；不开 hardened runtime；只出 arm64 dmg', async () => {
+    const { createElectronBuilderConfig } = await import('../scripts/electron-builder-config.mjs')
+    const c = createElectronBuilderConfig(base, 'darwin', 'arm64') as unknown as MacConfig
+    expect(c.mac).toMatchObject({ identity: null, forceCodeSigning: false, hardenedRuntime: false, notarize: false, target: [{ target: 'dmg', arch: ['arm64'] }] })
+    expect(c.dmg.sign).toBe(false)
+    expect((c as { publish?: unknown }).publish).toBeNull()                 // 不带更新源：产品不外连（同 Windows 未签名包）
+  })
+  it('没有开关又没有签名身份：照 DSH 原样报错（不悄悄出未签名包）', async () => {
+    const { createElectronBuilderConfig } = await import('../scripts/electron-builder-config.mjs')
+    const { LAWBENCH_MAC_ADHOC: _, ...signed } = base
+    expect(() => createElectronBuilderConfig(signed, 'darwin', 'arm64')).toThrow(/SIGNING_IDENTITY/)
+  })
+  it('载荷进 Contents/Resources（extraResources），不用 extraFiles；requirements.txt 不带', async () => {
+    const { createElectronBuilderConfig } = await import('../scripts/electron-builder-config.mjs')
+    const c = createElectronBuilderConfig({ ...base, LAWBENCH_STAGE_DIR: '/build/stage' }, 'darwin', 'arm64') as unknown as MacConfig
+    expect(c.extraResources).toContainEqual({ from: '/build/stage', to: '.', filter: ['**/*', '!requirements.txt'] })
+    expect(c.extraFiles).toBeUndefined()
+  })
+  it('dmg 里：主程序、"应用程序"快捷方式、两个小工具并排（令 1424 第 4 条）', async () => {
+    const { createElectronBuilderConfig, lawbenchDmgContents } = await import('../scripts/electron-builder-config.mjs')
+    const apps = '/build/tools/长截图切分.app:/build/tools/格式互转.app'
+    const c = createElectronBuilderConfig({ ...base, LAWBENCH_MAC_DMG_APPS: apps }, 'darwin', 'arm64') as unknown as MacConfig
+    expect(c.dmg.contents).toEqual(lawbenchDmgContents(apps))
+    expect(lawbenchDmgContents(apps)).toEqual([
+      { x: 130, y: 150 },
+      { x: 410, y: 150, type: 'link', path: '/Applications' },
+      { x: 130, y: 330, type: 'file', path: '/build/tools/长截图切分.app' },
+      { x: 410, y: 330, type: 'file', path: '/build/tools/格式互转.app' },
+    ])
+  })
+  it('Windows 配置不受开关影响：照旧 extraFiles', async () => {
+    const { createElectronBuilderConfig } = await import('../scripts/electron-builder-config.mjs')
+    const win = { ...base, DSH_DESKTOP_TARGET_PLATFORM: 'win32', DSH_DESKTOP_TARGET_ARCH: 'x64', DSH_DESKTOP_UNSIGNED: '1', LAWBENCH_STAGE_DIR: 'D:\\build\\stage' }
+    const c = createElectronBuilderConfig(win, 'win32', 'x64') as unknown as MacConfig
+    expect(c.extraFiles).toEqual([{ from: 'D:\\build\\stage', to: '.', filter: ['**/*', '!requirements.txt'] }])
+    expect(c.extraResources.some((r) => r.from === 'D:\\build\\stage')).toBe(false)
+  })
+})
