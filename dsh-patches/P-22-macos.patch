index 7e1fe411b0..795c5275e7 100644
--- a/apps/desktop/scripts/lawbench-product.mjs
+++ b/apps/desktop/scripts/lawbench-product.mjs
@@ -8,3 +8,26 @@ export const LAWBENCH_PRODUCT_NAME = '连越律师工作台'
 
 /** lawbench P-4 (order 1756): the version of the packaged app (installer name, About, app.getVersion()); equals dsh-ext/shared/product.ts PRODUCT_VERSION. DSH's own package version stays for the bundled runtime checks. */
 export const LAWBENCH_VERSION = '0.1.0'
+
+/**
+ * lawbench T28 (order 1424 ruling 3): LAWBENCH_MAC_ADHOC=1 packages the macOS app without a Developer ID: no signing
+ * keychain, no notarization, ad-hoc signature applied by packaging/mac (LAWBENCH_MAC_SIGN_SCRIPT, inside out, LibreOffice.app
+ * keeps its own signature). Windows packaging never reads it.
+ * @param {NodeJS.ProcessEnv} env Packaging environment.
+ * @returns {boolean} Whether this is an ad-hoc macOS build.
+ */
+export const lawbenchMacAdhoc = env => env.LAWBENCH_MAC_ADHOC === '1'
+
+/**
+ * lawbench T28 (eighth run): the ad-hoc macOS build leaves out DSH's own native LibreOffice engine
+ * (@deepseek-ai/libreoffice-kit-<platform>-<arch>, a LibreOfficeDev.app of several hundred MB). lawbench never mounts DSH's
+ * Office bundle (P-12) and ships its own LibreOffice for the workbench service (Resources/tools/LibreOffice.app).
+ * @param {string} path Path relative to the production node_modules directory.
+ * @param {string} engine Engine suffix selected from the installed kit manifest (e.g. darwin-arm64; 'wasm' is kept).
+ * @returns {boolean} Whether the path belongs to that native engine package.
+ */
+export function lawbenchOfficeEngineEntry(path, engine) {
+  if (engine === 'wasm') return false
+  const parts = path.split(/[\\/]/u)
+  return parts.some((part, i) => part === '@deepseek-ai' && parts[i + 1] === `libreoffice-kit-${engine}`)
+}
