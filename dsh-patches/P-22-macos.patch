--- a/apps/desktop/src/lawbench-retainer.ts
+++ b/apps/desktop/src/lawbench-retainer.ts
@@ -39,7 +39,8 @@ export type RetainerResult =
  * `LAWBENCH_ENGINES_DIR` when given, else the repository's `engines`.
  */
 export function enginesDirectory(env: NodeJS.ProcessEnv = process.env): string {
-  if (app.isPackaged) return join(dirname(process.execPath), 'engines')
+  // lawbench T28: on macOS the payload is in <App>.app/Contents/Resources (process.resourcesPath), not next to the executable
+  if (app.isPackaged) return process.platform === 'darwin' ? join(process.resourcesPath, 'engines') : join(dirname(process.execPath), 'engines')
   const configured = env.LAWBENCH_ENGINES_DIR
   if (configured !== undefined && configured !== '' && isAbsolute(configured)) return configured
   return resolve(app.getAppPath(), '..', '..', '..', 'engines')
diff --git a/apps/desktop/tests/lawbench-macos.spec.ts b/apps/desktop/tests/lawbench-macos.spec.ts
new file mode 100644
index 0000000000..8bee2728cd
--- /dev/null
+++ b/apps/desktop/tests/lawbench-macos.spec.ts
@@ -0,0 +1,143 @@
+import { readFileSync } from 'node:fs'
+import { join } from 'node:path'
+import { describe, expect, it } from 'vitest'
+import { lawbenchIsolatedPaths } from '../src/lawbench-isolation.ts'
+
+// lawbench T28（令 1424）：macOS 版第一阶段——隔离目录、ad-hoc 打包开关、载荷放进 Contents/Resources、dmg 里并排放小工具。
+// Windows 的原有行为由 lawbench-isolation / lawbench-stage 等原用例守着。
+
+const base = {
+  DSH_DESKTOP_APP_ID: 'cn.lianyue.lawbench',
+  DSH_DESKTOP_MANDATORY_UPDATE_TEST_ORIGIN: 'https://policy.example.com',
+  DSH_DESKTOP_MANDATORY_UPDATE_CONFIG: JSON.stringify({ allowedAuthOrigins: ['https://login.example.com'] }),
+  DSH_DESKTOP_TARGET_PLATFORM: 'darwin',
+  DSH_DESKTOP_TARGET_ARCH: 'arm64',
+  LAWBENCH_MAC_ADHOC: '1',
+}
+type MacConfig = {
+  mac: { identity?: string | null; forceCodeSigning?: boolean; hardenedRuntime?: boolean; notarize?: boolean; target?: unknown }
+  dmg: { sign?: boolean; contents?: unknown }
+  extraResources: Array<{ from: string; to: string; filter?: string[] }>
+  extraFiles?: unknown
+}
+
+describe('macOS 隔离目录（T28）', () => {
+  it('装好的 Mac 包：userData 与 DSH_HOME 进 ~/Library/Application Support 下我方目录', () => {
+    expect(lawbenchIsolatedPaths({}, true, 'darwin', '/Users/x')).toEqual({
+      userData: '/Users/x/Library/Application Support/lawbench-desktop',
+      dshHome: '/Users/x/Library/Application Support/lawbench/dsh-home',
+    })
+  })
+  it('开发期不搬家；Windows 缺变量时照旧不搬', () => {
+    expect(lawbenchIsolatedPaths({}, false, 'darwin', '/Users/x')).toBeUndefined()
+    expect(lawbenchIsolatedPaths({}, true, 'win32', 'C:\\Users\\x')).toBeUndefined()
+  })
+})
+
+// 第一次导入打包配置模块较慢（与其他打包用例并发时超过默认 5 秒）
+describe('ad-hoc 打包开关（T28，令 1424 第 3 条）', { timeout: 60_000 }, () => {
+  it('LAWBENCH_MAC_ADHOC=1：不要签名身份与公证凭据；不开 hardened runtime；只出 arm64 dmg', async () => {
+    const { createElectronBuilderConfig } = await import('../scripts/electron-builder-config.mjs')
+    const c = createElectronBuilderConfig(base, 'darwin', 'arm64') as unknown as MacConfig
+    expect(c.mac).toMatchObject({ identity: null, forceCodeSigning: false, hardenedRuntime: false, notarize: false, target: [{ target: 'dmg', arch: ['arm64'] }] })
+    expect(c.dmg.sign).toBe(false)
+    expect((c as { publish?: unknown }).publish).toBeNull()                 // 不带更新源：产品不外连（同 Windows 未签名包）
+  })
+  it('没有开关又没有签名身份：照 DSH 原样报错（不悄悄出未签名包）', async () => {
+    const { createElectronBuilderConfig } = await import('../scripts/electron-builder-config.mjs')
+    const { LAWBENCH_MAC_ADHOC: _, ...signed } = base
+    expect(() => createElectronBuilderConfig(signed, 'darwin', 'arm64')).toThrow(/SIGNING_IDENTITY/)
+  })
+  it('载荷进 Contents/Resources（extraResources），不用 extraFiles；requirements.txt 不带', async () => {
+    const { createElectronBuilderConfig } = await import('../scripts/electron-builder-config.mjs')
+    const c = createElectronBuilderConfig({ ...base, LAWBENCH_STAGE_DIR: '/build/stage' }, 'darwin', 'arm64') as unknown as MacConfig
+    expect(c.extraResources).toContainEqual({ from: '/build/stage', to: '.', filter: ['**/*', '!requirements.txt'] })
+    expect(c.extraFiles).toBeUndefined()
+  })
+  it('dmg 里：主程序、"应用程序"快捷方式、两个小工具并排（令 1424 第 4 条）', async () => {
+    const { createElectronBuilderConfig, lawbenchDmgContents } = await import('../scripts/electron-builder-config.mjs')
+    const apps = '/build/tools/长截图切分.app:/build/tools/格式互转.app'
+    const c = createElectronBuilderConfig({ ...base, LAWBENCH_MAC_DMG_APPS: apps }, 'darwin', 'arm64') as unknown as MacConfig
+    expect(c.dmg.contents).toEqual(lawbenchDmgContents(apps))
+    expect(lawbenchDmgContents(apps)).toEqual([
+      { x: 130, y: 150 },
+      { x: 410, y: 150, type: 'link', path: '/Applications' },
+      { x: 130, y: 330, type: 'file', path: '/build/tools/长截图切分.app' },
+      { x: 410, y: 330, type: 'file', path: '/build/tools/格式互转.app' },
+    ])
+  })
+  it('dmg 里的小工具路径都在 DSH 工作区（dsh/）内：electron-builder 拒收工作区外的 dmg.contents（第七跑）', async () => {
+    const { lawbenchDmgContents } = await import('../scripts/electron-builder-config.mjs')
+    // packaging/mac/build.sh 把两个小工具拷进 dsh/apps/desktop/lawbench-dmg-apps/ 再交给 LAWBENCH_MAC_DMG_APPS
+    const build = readFileSync(join(__dirname, '..', '..', '..', '..', 'packaging', 'mac', 'build.sh'), 'utf8')
+    expect(build).toContain('local dmgapps="$DSH/apps/desktop/lawbench-dmg-apps"')
+    expect(build).toMatch(/apps="\$\(find "\$dmgapps"/)
+    const dsh = '/w/lawbench/dsh'
+    const apps = [`${dsh}/apps/desktop/lawbench-dmg-apps/长截图切分.app`, `${dsh}/apps/desktop/lawbench-dmg-apps/格式互转.app`].join(':')
+    const files = lawbenchDmgContents(apps).filter((c: { type?: string }) => c.type === 'file')
+    expect(files).toHaveLength(2)
+    for (const c of files) expect((c as { path: string }).path.startsWith(`${dsh}/`)).toBe(true)
+  })
+  it('Windows 配置不受开关影响：照旧 extraFiles', async () => {
+    const { createElectronBuilderConfig } = await import('../scripts/electron-builder-config.mjs')
+    const win = { ...base, DSH_DESKTOP_TARGET_PLATFORM: 'win32', DSH_DESKTOP_TARGET_ARCH: 'x64', DSH_DESKTOP_UNSIGNED: '1', LAWBENCH_STAGE_DIR: 'D:\\build\\stage' }
+    const c = createElectronBuilderConfig(win, 'win32', 'x64') as unknown as MacConfig
+    expect(c.extraFiles).toEqual([{ from: 'D:\\build\\stage', to: '.', filter: ['**/*', '!requirements.txt'] }])
+    expect(c.extraResources.some((r) => r.from === 'D:\\build\\stage')).toBe(false)
+  })
+})
+
+describe('ad-hoc 构建不走 Developer ID 签名（T28 第五跑）', { timeout: 60_000 }, () => {
+  it('prepare-dsh：两步原生模块签名只在 macOS 且非 ad-hoc 时执行（Windows 上 process.platform 不是 darwin，照旧不进）', () => {
+    const src = readFileSync(join(__dirname, '..', 'scripts', 'prepare-dsh.ts'), 'utf8')
+    const guard = src.indexOf("if (process.platform === 'darwin' && !lawbenchMacAdhoc(process.env)) {")
+    expect(guard).toBeGreaterThan(0)
+    const block = src.slice(guard, src.indexOf('\n    }\n', guard))
+    expect(block).toContain("'sign:dsh-native'")
+    expect(block).toContain("'sign:primary-native'")
+    expect(src.split('resolveMacOSSigningEnvironment(process.env)').length - 1).toBe(2)   // 没有别处在开关外调用
+  })
+  it('开关只认 LAWBENCH_MAC_ADHOC=1', async () => {
+    const { lawbenchMacAdhoc } = await import('../scripts/lawbench-product.mjs')
+    expect(lawbenchMacAdhoc({ LAWBENCH_MAC_ADHOC: '1' })).toBe(true)
+    expect(lawbenchMacAdhoc({ LAWBENCH_MAC_ADHOC: 'true' })).toBe(false)
+    expect(lawbenchMacAdhoc({})).toBe(false)
+  })
+  it('签名构建照旧：没有签名身份时 resolveMacOSSigningEnvironment 仍报错（P-22 没改它）', async () => {
+    const { resolveMacOSSigningEnvironment } = await import('../scripts/desktop-release-environment.mjs')
+    expect(() => resolveMacOSSigningEnvironment({ LAWBENCH_MAC_ADHOC: '1' })).toThrow(/SIGNING_IDENTITY/)
+  })
+})
+
+describe('ad-hoc 构建不带 DSH 自己的 LibreOffice 引擎、unpacked 内容与清单一致（T28 第八跑）', { timeout: 60_000 }, () => {
+  it('lawbenchOfficeEngineEntry：只认原生引擎包，wasm 与外层 libreoffice-kit 包不动', async () => {
+    const { lawbenchOfficeEngineEntry } = await import('../scripts/lawbench-product.mjs')
+    expect(lawbenchOfficeEngineEntry('@deepseek-ai/libreoffice-kit-darwin-arm64', 'darwin-arm64')).toBe(true)
+    expect(lawbenchOfficeEngineEntry('@deepseek-ai/libreoffice-kit-darwin-arm64/program/LibreOfficeDev.app/Contents/_CodeSignature/CodeDirectory', 'darwin-arm64')).toBe(true)
+    expect(lawbenchOfficeEngineEntry('@deepseek-ai\\libreoffice-kit-darwin-arm64\\prebuilds.json', 'darwin-arm64')).toBe(true)
+    expect(lawbenchOfficeEngineEntry('@deepseek-ai/libreoffice-kit/package.json', 'darwin-arm64')).toBe(false)
+    expect(lawbenchOfficeEngineEntry('@deepseek-ai/libreoffice-kit-wasm/x', 'wasm')).toBe(false)
+    expect(lawbenchOfficeEngineEntry('sherpa-onnx-darwin-arm64/libonnxruntime.dylib', 'darwin-arm64')).toBe(false)
+  })
+  it('prepare-dsh：ad-hoc 时复制运行时跳过原生引擎、不再要求它存在、在封清单前逐个 ad-hoc 签 Mach-O', () => {
+    const src = readFileSync(join(__dirname, '..', 'scripts', 'prepare-dsh.ts'), 'utf8')
+    expect(src).toContain("const omitOfficeEngine = process.platform === 'darwin' && lawbenchMacAdhoc(process.env)")
+    expect(src).toContain('&& !(omitOfficeEngine && lawbenchOfficeEngineEntry(relative(modules, source), officeEngine))')
+    expect(src).toContain('if (!omitOfficeEngine && !existsSync(')
+    const adhoc = src.indexOf("} else if (process.platform === 'darwin') {")
+    expect(adhoc).toBeGreaterThan(0)
+    expect(src.indexOf("'sign:dsh-native-adhoc'", adhoc)).toBeGreaterThan(adhoc)
+    expect(src.indexOf("'sign:primary-native-adhoc'", adhoc)).toBeGreaterThan(adhoc)
+    expect(src.indexOf("'runtime:write-descriptor'")).toBeGreaterThan(src.indexOf("'sign:primary-native-adhoc'"))   // 先签后封清单
+  })
+  it('electron-builder：ad-hoc 时 beforePack 不再找 Office 包目录（引擎已不在）', () => {
+    const src = readFileSync(join(__dirname, '..', 'scripts', 'electron-builder-config.mjs'), 'utf8')
+    expect(src).toContain('const office = macAdhoc ? [] : await officePackageDirectories(')
+  })
+  it('lawbenchAdhocSignRuntime 只签单个 Mach-O 文件，不签 bundle、不加文件', () => {
+    const src = readFileSync(join(__dirname, '..', 'scripts', 'macos-runtime.ts'), 'utf8')
+    const body = src.slice(src.indexOf('export async function lawbenchAdhocSignRuntime'))
+    expect(body).toContain("['--force', '--sign', '-', '--timestamp=none', join(root, path)]")
+    expect(body).not.toContain('--deep')
+  })
+})
