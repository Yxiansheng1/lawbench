+  it('lawbench P-5: a registered intake hook takes the files before references or uploads', async () => {
+    vi.stubGlobal('__DSH_HOST_PATHS__', { pathFor: (file: File) => `/proj/${file.name}` })
+    onTestFinished(() => { vi.unstubAllGlobals() })
+    const b = await bench()
+    onTestFinished(() => b.runtime.dispose())
+    const composer = b.composerApi(ROOT)
+    const { state } = b.inputApi(ROOT)
+    const intake = b.runtime.ctx.get('conversationFileIntake')!
+    const note = new File([Uint8Array.of(1)], 'notes.md', { type: 'text/markdown' })
+    const shot = new File([Uint8Array.of(2)], 'shot.png', { type: 'image/png' })
+    const seen: Array<[SessionId, string[]]> = []
+    let answer: string | null | undefined = null
+    const off = intake.register((sessionId, files) => { seen.push([sessionId, files.map(f => f.name)]); return answer })
+    // Taken: no reference chip, no draft attachment, no upload.
+    expect(composer.addFiles?.([note, shot])).toBeNull()
+    expect(seen).toEqual([[ROOT, ['notes.md', 'shot.png']]])
+    expect(state.getSnapshot().draft).toBe('')
+    expect(state.getSnapshot().attachmentIds).toEqual([])
+    // Refused: the hook's message is the composer's answer, still nothing added.
+    answer = '请先打开案件'
+    expect(composer.addFiles?.([note])).toBe('请先打开案件')
+    expect(state.getSnapshot().draft).toBe('')
+    // Undefined: left to the default path (a reference chip).
+    answer = undefined
+    expect(composer.addFiles?.([note])).toBeNull()
+    expect(state.getSnapshot().draft).toBe('@notes.md ')
+    // Disposed: the hook is no longer consulted.
+    off()
+    seen.length = 0
+    expect(composer.addFiles?.([note])).toBeNull()
+    expect(seen).toEqual([])
+    expect(b.rootUpload).not.toHaveBeenCalled()
+  })
+
   it('preserves selected text and file order and restores pasted directory chips from the draft', async () => {
