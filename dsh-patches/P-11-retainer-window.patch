diff --git a/apps/desktop/src/preload-retainer.ts b/apps/desktop/src/preload-retainer.ts
new file mode 100644
index 0000000000..8b895efe08
--- /dev/null
+++ b/apps/desktop/src/preload-retainer.ts
@@ -0,0 +1,20 @@
+/**
+ * lawbench P-11 (Spec 13.5): the retainer page may not write folders directly. Before any page script
+ * runs, remove the File System Access pickers that write (`showDirectoryPicker`, `showSaveFilePicker`)
+ * from the page's world; the page then falls back to downloads, which the main process saves into the
+ * case's temporary folder. Nothing is exposed to the page.
+ */
+
+import { contextBridge } from 'electron'
+
+contextBridge.executeInMainWorld({
+  func: () => {
+    for (const name of ['showDirectoryPicker', 'showSaveFilePicker']) {
+      for (const owner of [window, Object.getPrototypeOf(window), Window.prototype]) {
+        try { Reflect.deleteProperty(owner, name) } catch { /* not configurable */ }
+      }
+      // Still reachable (not deletable): pin it to undefined so `if (!window.showDirectoryPicker)` takes the download path.
+      if (name in window) Object.defineProperty(window, name, { value: undefined, writable: false, configurable: false })
+    }
+  },
+})
