@@ -0,0 +1,220 @@
+import { mkdirSync, mkdtempSync, rmSync, symlinkSync, writeFileSync } from 'node:fs'
+import { tmpdir } from 'node:os'
+import { join } from 'node:path'
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'
+import { DESKTOP_IPC } from '../src/ipc.ts'
+
+// lawbench P-11（Spec 3.2 P-11、13.5）：委托材料窗口。主进程这一半：独立分区、白名单、关拼写检查、拒权限、
+// 禁跳转和新窗口、下载落案件临时目录（同名改名）、只有主窗口顶层能开、关窗后把下载结果交回。
+
+type Handler = (event: unknown, value?: unknown) => Promise<unknown>
+const electron = vi.hoisted(() => ({
+  handlers: new Map<string, Handler>(),
+  windows: [] as Array<ReturnType<typeof fakeWindow>>,
+  sessions: new Map<string, ReturnType<typeof fakeSession>>(),
+  appPath: '',
+}))
+
+function emitter() {
+  const on = new Map<string, Array<(...a: unknown[]) => void>>()
+  return {
+    on: vi.fn((name: string, fn: (...a: unknown[]) => void) => { on.set(name, [...on.get(name) ?? [], fn]) }),
+    once: vi.fn((name: string, fn: (...a: unknown[]) => void) => { on.set(name, [...on.get(name) ?? [], fn]) }),
+    emit: (name: string, ...a: unknown[]) => { for (const fn of on.get(name) ?? []) fn(...a) },
+    has: (name: string) => (on.get(name)?.length ?? 0) > 0,
+  }
+}
+function fakeSession() {
+  const ev = emitter()
+  return {
+    ...ev,
+    setSpellCheckerEnabled: vi.fn(),
+    setPermissionRequestHandler: vi.fn(),
+    setPermissionCheckHandler: vi.fn(),
+    webRequest: { onBeforeRequest: vi.fn() },
+  }
+}
+let nextId = 100
+function fakeWindow(options: unknown) {
+  const ev = emitter()
+  const contents = { ...emitter(), id: ++nextId, mainFrame: {}, setWindowOpenHandler: vi.fn() }
+  return {
+    ...ev,
+    options,
+    webContents: contents,
+    loadFile: vi.fn(async (_p: string) => {}),
+    isDestroyed: vi.fn(() => false),
+    isMinimized: vi.fn(() => false),
+    restore: vi.fn(), focus: vi.fn(), show: vi.fn(), destroy: vi.fn(),
+  }
+}
+vi.mock('electron', () => ({
+  app: { isPackaged: false, getAppPath: () => electron.appPath, getPath: () => electron.appPath },
+  BrowserWindow: vi.fn(function (options: unknown) { const w = fakeWindow(options); electron.windows.push(w); return w }),
+  ipcMain: {
+    handle: (name: string, handler: Handler) => {
+      if (electron.handlers.has(name)) throw new Error(`duplicate IPC handler: ${name}`)
+      electron.handlers.set(name, handler)
+    },
+  },
+  session: { fromPartition: (p: string) => { if (!electron.sessions.has(p)) electron.sessions.set(p, fakeSession()); return electron.sessions.get(p)! } },
+}))
+
+const mod = await import('../src/lawbench-retainer.ts')
+
+let dir: string
+let engines: string
+let caseRoot: string
+let mainWindow: { webContents: { mainFrame: object }; isDestroyed(): boolean }
+const env = { ...process.env }
+
+beforeEach(() => {
+  dir = mkdtempSync(join(tmpdir(), 'lb-retainer-'))
+  engines = join(dir, 'engines')
+  mkdirSync(join(engines, 'retainer'), { recursive: true })
+  writeFileSync(join(engines, 'retainer', '启动.html'), '<!doctype html>')
+  caseRoot = join(dir, '民事-虚构甲')
+  mkdirSync(join(caseRoot, '工作区'), { recursive: true })
+  process.env.LAWBENCH_ENGINES_DIR = engines
+  process.env.LOCALAPPDATA = join(dir, 'Local')
+  electron.windows.length = 0
+  mainWindow = { webContents: { mainFrame: {} }, isDestroyed: () => false }
+})
+afterEach(() => { rmSync(dir, { recursive: true, force: true }); process.env = { ...env } })
+
+if (!electron.handlers.has(DESKTOP_IPC.lawbenchRetainerOpen)) mod.installRetainerWindow(() => mainWindow as never)
+const handler = () => electron.handlers.get(DESKTOP_IPC.lawbenchRetainerOpen)!
+// 主窗口顶层发来的请求（assertDesktopSender 还核 senderFrame.url 是 dsh-app://app）
+const appEvent = () => {
+  (mainWindow.webContents.mainFrame as Record<string, unknown>).url = 'dsh-app://app/index.html'
+  return { sender: mainWindow.webContents, senderFrame: mainWindow.webContents.mainFrame }
+}
+const flush = () => new Promise((r) => setTimeout(r, 0))
+const download = (name: string) => {
+  const item = { ...emitter(), getFilename: () => name, setSavePath: vi.fn() }
+  return item
+}
+
+describe('委托材料窗口（lawbench P-11）', () => {
+  it('窗口：独立分区、沙箱、无 Node、无 webview、关拼写检查；标题显示案件名', () => {
+    const o = mod.retainerWindowOptions(mod.retainerTitle('民事-虚构甲', true))
+    expect(o.title).toBe('委托材料 — 民事-虚构甲')
+    expect(o.webPreferences).toMatchObject({ partition: 'persist:retainer', nodeIntegration: false, contextIsolation: true, sandbox: true, webviewTag: false, spellcheck: false })
+    expect(o.webPreferences?.preload).toMatch(/preload-retainer\.cjs$/u)
+    expect(mod.retainerTitle(null, false)).toBe('委托材料（没有打开案件）')
+  })
+
+  it('分区只放行本页文件和 127.0.0.1:17801；拼写检查关、权限一律拒', () => {
+    const ses = fakeSession()
+    const pageDir = join(engines, 'retainer')
+    mod.prepareRetainerSession(ses as never, pageDir)
+    expect(ses.setSpellCheckerEnabled).toHaveBeenCalledWith(false)
+    const filter = ses.webRequest.onBeforeRequest.mock.calls[0]![0] as (d: { url: string }, cb: (r: { cancel: boolean }) => void) => void
+    const cancel = (url: string) => { let c: boolean | undefined; filter({ url }, (r) => { c = r.cancel }); return c }
+    expect(cancel('http://127.0.0.1:17801/ocr')).toBe(false)
+    expect(cancel(new URL(`file:///${join(pageDir, 'app', 'ui.js').replace(/\\/gu, '/')}`).href)).toBe(false)
+    expect(cancel('blob:file:///x')).toBe(false)
+    for (const url of ['http://127.0.0.1:17802/', 'http://localhost:17801/', 'https://example.com/', 'http://192.168.8.77:8000/v1/models', 'ws://127.0.0.1:18765/',
+      new URL(`file:///${join(dir, 'other.txt').replace(/\\/gu, '/')}`).href, 'file://server/share/a.docx']) expect(cancel(url), url).toBe(true)
+    const perm = ses.setPermissionRequestHandler.mock.calls[0]![0] as (w: unknown, p: string, cb: (ok: boolean) => void) => void
+    let granted: boolean | undefined
+    perm({}, 'media', (ok) => { granted = ok })
+    expect(granted).toBe(false)
+    expect((ses.setPermissionCheckHandler.mock.calls[0]![0] as () => boolean)()).toBe(false)
+  })
+
+  it('禁跳转、禁重定向、禁新窗口、禁子框架跳转、禁 webview', () => {
