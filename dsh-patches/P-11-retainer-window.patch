index 0000000000..ed4a9fb03b
--- /dev/null
+++ b/apps/desktop/src/lawbench-retainer.ts
@@ -0,0 +1,226 @@
+/**
+ * lawbench P-11 (Spec 3.2 P-11, 13.5): the retainer-materials window. The main window asks over
+ * `lawbench:open-retainer` to open the firm's offline retainer page (`engines/retainer/启动.html`) in a
+ * window of its own partition (`persist:retainer`, storage kept apart from the main window). That
+ * partition is a separate session, so P-9 does not reach it: it gets the same request whitelist
+ * (only the page's own files and the local ID-card recognition driver on 127.0.0.1:17801), no
+ * spellchecker, no permissions, no navigation and no new windows. The preload removes
+ * `showDirectoryPicker` so the page falls back to downloads, and every download is saved into the
+ * current case's `工作区/临时/委托材料/<时间>/` (without a case: `<应用数据>/临时/委托材料/<时间>/`).
+ * The invoke settles when the window closes, with the files saved; the renderer then stops the driver
+ * and offers the import into `01委托手续` (an import only adds, never overwrites).
+ */
+
+import { app, BrowserWindow, ipcMain, session, type DownloadItem, type IpcMainInvokeEvent, type Session, type WebContents } from 'electron'
+import { existsSync, lstatSync, mkdirSync } from 'node:fs'
+import { dirname, isAbsolute, join, resolve } from 'node:path'
+import { fileURLToPath } from 'node:url'
+import { DESKTOP_IPC, assertDesktopSender } from './ipc.ts'
+import { lawbenchRequestAllowed } from './lawbench-request-policy.ts'
+
+export const RETAINER_PARTITION = 'persist:retainer'
+/** The ID-card recognition driver the page talks to (its own CSP allows nothing else). */
+export const RETAINER_DRIVER_URL = 'http://127.0.0.1:17801'
+
+/** What the main window sends: the current case (folder and name), or none. */
+export interface RetainerOpenRequest {
+  readonly caseRoot: string | null
+  readonly caseName: string | null
+}
+
+/** How the invoke settles. */
+export type RetainerResult =
+  | { readonly kind: 'closed'; readonly dir: string; readonly inCase: boolean; readonly files: readonly string[]; readonly failed: number }
+  | { readonly kind: 'already-open' }
+
+/** The installed engines directory: `LAWBENCH_ENGINES_DIR`, else next to the executable (packaged), else the repository's `engines`. */
+export function enginesDirectory(env: NodeJS.ProcessEnv = process.env): string {
+  const configured = env.LAWBENCH_ENGINES_DIR
+  if (configured !== undefined && configured !== '' && isAbsolute(configured)) return configured
+  return app.isPackaged ? join(dirname(process.execPath), 'engines') : resolve(app.getAppPath(), '..', '..', '..', 'engines')
+}
+
+/** The application data directory the Host gives the service (`%LOCALAPPDATA%\lawbench`). */
+function appDataDirectory(env: NodeJS.ProcessEnv = process.env): string {
+  return join(env.LOCALAPPDATA ?? app.getPath('appData'), 'lawbench')
+}
+
+/** Check the renderer's request; anything else is refused. */
+export function parseOpenRequest(value: unknown): RetainerOpenRequest {
+  if (typeof value !== 'object' || value === null) throw new Error('lawbench retainer: malformed request')
+  const { caseRoot, caseName } = value as Record<string, unknown>
+  const text = (v: unknown, max: number): string | null => {
+    if (v === null || v === undefined) return null
+    if (typeof v !== 'string' || v.length > max || /[\u0000-\u001f]/u.test(v)) throw new Error('lawbench retainer: malformed request')
+    return v
+  }
+  return { caseRoot: text(caseRoot, 1024), caseName: text(caseName, 200) }
+}
+
+/** A case folder counts only when it is an absolute, real (not linked) folder that has `工作区`. */
+export function usableCaseRoot(root: string | null): string | undefined {
+  if (root === null || !isAbsolute(root)) return undefined
+  try {
+    const top = lstatSync(root)
+    const work = lstatSync(join(root, '工作区'))
+    return top.isDirectory() && !top.isSymbolicLink() && work.isDirectory() && !work.isSymbolicLink() ? root : undefined
+  } catch { return undefined }
+}
+
+/** `<时间>` folder name, local time, to the second. */
+export function stamp(now: Date): string {
+  const p = (n: number): string => String(n).padStart(2, '0')
+  return `${now.getFullYear()}${p(now.getMonth() + 1)}${p(now.getDate())}-${p(now.getHours())}${p(now.getMinutes())}${p(now.getSeconds())}`
+}
+
+/** Where this window's downloads go. */
+export function downloadDirectory(caseRoot: string | undefined, appData: string, now: Date): string {
+  return caseRoot !== undefined
+    ? join(caseRoot, '工作区', '临时', '委托材料', stamp(now))
+    : join(appData, '临时', '委托材料', stamp(now))
+}
+
+const RESERVED = /^(con|prn|aux|nul|com[1-9]|lpt[1-9])(\..*)?$/iu
+
+/** A plain file name for a suggested download name: no folders, no characters Windows refuses. */
+export function safeDownloadName(name: string): string {
+  const last = name.split(/[\\/]/u).pop() ?? ''
+  // eslint-disable-next-line no-control-regex
+  const cleaned = last.replace(/[<>:"|?*\u0000-\u001f]/gu, '_').replace(/[. ]+$/u, '').trim()
+  if (cleaned === '' || cleaned === '.' || cleaned === '..') return '下载文件'
+  return RESERVED.test(cleaned) ? `_${cleaned}` : cleaned.slice(0, 180)
+}
+
+/** First free name in the folder: `名.docx`, `名(2).docx`, … (also avoids names already handed out). */
+export function freeName(dir: string, name: string, taken: ReadonlySet<string>): string {
+  const dot = name.lastIndexOf('.')
+  const [stem, ext] = dot > 0 ? [name.slice(0, dot), name.slice(dot)] : [name, '']
+  for (let n = 1; ; n++) {
+    const candidate = n === 1 ? name : `${stem}(${n})${ext}`
+    if (!taken.has(candidate.toLowerCase()) && !existsSync(join(dir, candidate))) return candidate
+  }
+}
+
+/** Window options: own partition, sandboxed, no Node, no webview, no spellchecker. */
+export function retainerWindowOptions(title: string): Electron.BrowserWindowConstructorOptions {
+  return {
+    width: 1280,
+    height: 860,
+    show: false,
+    title,
+    autoHideMenuBar: true,
+    webPreferences: {
+      partition: RETAINER_PARTITION,
+      preload: fileURLToPath(new URL('./preload-retainer.cjs', import.meta.url)),
+      nodeIntegration: false,
+      contextIsolation: true,
+      sandbox: true,
+      webSecurity: true,
+      webviewTag: false,
+      spellcheck: false,
+      navigateOnDragDrop: false,
+    },
+  }
+}
+
+/** Window title: shows the current case name. */
+export function retainerTitle(caseName: string | null, inCase: boolean): string {
+  return inCase && caseName ? `委托材料 — ${caseName}` : '委托材料（没有打开案件）'
+}
+
+interface Downloads {
+  dir: string
+  taken: Set<string>
+  files: string[]
+  failed: number
+  pending: number
+  settled?: () => void
+}
+
+const prepared = new WeakSet<Session>()
+const owners = new Map<number, Downloads>()
+
+/** One-time setup of the retainer partition (whitelist, spellchecker, permissions, downloads). */
+export function prepareRetainerSession(ses: Session, pageDir: string): void {
+  if (prepared.has(ses)) return
+  prepared.add(ses)
+  ses.setSpellCheckerEnabled(false)
+  ses.webRequest.onBeforeRequest((details, callback) => {
+    callback({ cancel: !lawbenchRequestAllowed(details.url, RETAINER_DRIVER_URL, pageDir) })
+  })
+  ses.setPermissionRequestHandler((_contents, _permission, callback) => { callback(false) })
+  ses.setPermissionCheckHandler(() => false)
+  ses.on('will-download', (event, item: DownloadItem, contents: WebContents | undefined) => {
+    const owner = contents === undefined ? undefined : owners.get(contents.id)
+    if (owner === undefined) { event.preventDefault(); return }
+    try { mkdirSync(owner.dir, { recursive: true }) } catch { event.preventDefault(); owner.failed++; return }
+    const name = freeName(owner.dir, safeDownloadName(item.getFilename()), owner.taken)
+    owner.taken.add(name.toLowerCase())
+    item.setSavePath(join(owner.dir, name))
+    owner.pending++
+    item.once('done', (_e, state) => {
+      if (state === 'completed') owner.files.push(join(owner.dir, name))
+      else owner.failed++
+      owner.pending--
+      if (owner.pending === 0) owner.settled?.()
+    })
+  })
+}
+
+/** Keep the window on its page (loaded by the main process; the page itself may not navigate): no navigation, no redirects, no new windows, no webviews, fixed title. */
+export function lockRetainerContents(contents: WebContents): void {
+  contents.setWindowOpenHandler(() => ({ action: 'deny' }))
+  contents.on('will-navigate', (event) => { event.preventDefault() })
+  contents.on('will-redirect', (event) => { event.preventDefault() })
+  contents.on('will-frame-navigate', (event) => { if (!event.isMainFrame) event.preventDefault() })
+  contents.on('will-attach-webview', (event) => { event.preventDefault() })
+}
+
+/**
+ * Install `lawbench:open-retainer` (application lifetime). Only the main window's top frame may call it.
+ * @param getWindow - the current main window.
+ */
+export function installRetainerWindow(getWindow: () => BrowserWindow | undefined): void {
+  let open: BrowserWindow | undefined
+  ipcMain.handle(DESKTOP_IPC.lawbenchRetainerOpen, async (event: IpcMainInvokeEvent, value: unknown): Promise<RetainerResult> => {
+    const main = getWindow()
+    if (main === undefined || main.isDestroyed() || event.sender !== main.webContents || event.senderFrame !== main.webContents.mainFrame) {
+      throw new Error('lawbench retainer: rejected request from an unowned renderer')
+    }
+    assertDesktopSender(event, ['app'])
+    const request = parseOpenRequest(value)
+    if (open !== undefined && !open.isDestroyed()) {
+      if (open.isMinimized()) open.restore()
+      open.focus()
+      return { kind: 'already-open' }
+    }
+    const pageDir = join(enginesDirectory(), 'retainer')
+    const page = join(pageDir, '启动.html')
+    if (!existsSync(page)) throw new Error('委托材料工具没有找到，请重新安装律师工作台。')
+    const caseRoot = usableCaseRoot(request.caseRoot)
+    const downloads: Downloads = { dir: downloadDirectory(caseRoot, appDataDirectory(), new Date()), taken: new Set(), files: [], failed: 0, pending: 0 }
+    const ses = session.fromPartition(RETAINER_PARTITION)
+    prepareRetainerSession(ses, pageDir)
+    const window = new BrowserWindow(retainerWindowOptions(retainerTitle(request.caseName, caseRoot !== undefined)))
+    open = window
+    const contentsId = window.webContents.id
+    owners.set(contentsId, downloads)
+    window.on('page-title-updated', (e) => { e.preventDefault() })
+    lockRetainerContents(window.webContents)
+    const closed = new Promise<void>((done) => { window.once('closed', () => { done() }) })
+    window.once('ready-to-show', () => { window.show() })
+    try {
+      await window.loadFile(page)
+    } catch (error) {
+      owners.delete(contentsId)
+      if (!window.isDestroyed()) window.destroy()
+      open = undefined
+      throw error
+    }
+    await closed
+    open = undefined
+    if (downloads.pending > 0) await new Promise<void>((done) => { downloads.settled = done })
+    owners.delete(contentsId)
+    return { kind: 'closed', dir: downloads.dir, inCase: caseRoot !== undefined, files: downloads.files, failed: downloads.failed }
+  })
+}
