+++ b/apps/desktop/tests/lawbench-first-run.spec.ts
@@ -0,0 +1,70 @@
+// lawbench P-3：首次配置页的判断条件与输入校验（替代原 DeepSeek 欢迎流程的测试）。
+import { describe, expect, it } from 'vitest'
+import { isFirstRunInput, isServerAddresses, needsWelcome } from '../src/welcome-api.ts'
+import { connectDesktopWelcome } from '../src/welcome-backend.ts'
+
+/** 假的 Host：认证地址返回 authStatus；/api/<ns>/<method> 按 reply 回信封。 */
+function fakeHost(authStatus: number, reply: (method: string) => { ok: true; value: unknown } | { ok: false; error: { code: string; message: string } }) {
+  return async (input: string, init?: RequestInit): Promise<Response> => {
+    const url = new URL(input)
+    if (!url.pathname.startsWith('/api/')) return new Response(null, { status: authStatus })
+    const body = JSON.parse(String(init?.body)) as { rpcId: string; method: string }
+    return Response.json({ type: 'server-response', rpcId: body.rpcId, result: reply(body.method) })
+  }
+}
+const AUTH_URL = 'http://127.0.0.1:19387/?token=t'
+
+describe('connectDesktopWelcome（T7 返修 P2-2）', () => {
+  it('未认证就拒绝：认证地址返回非 200 时抛错，不返回后端', async () => {
+    await expect(connectDesktopWelcome(AUTH_URL, fakeHost(401, () => ({ ok: true, value: {} })))).rejects.toThrow('Web authentication failed')
+  })
+
+  it('诊断信息不外泄：远端错误信息不是中文提示时换成通用文案，不把原文交给页面', async () => {
+    const backend = await connectDesktopWelcome(AUTH_URL, fakeHost(200, () => ({
+      ok: false, error: { code: 'gateway/internal', message: 'TypeError at C:\\Users\\x\\secret-path.js:12 token=abc' },
+    })))
+    const r = await backend.getSetup()
+    expect(r).toEqual({ ok: false, message: '工作台服务未启动，请稍后重试' })
+    expect(JSON.stringify(r)).not.toContain('secret-path')
+  })
+
+  it('远端给出的中文提示原样交给页面', async () => {
+    const backend = await connectDesktopWelcome(AUTH_URL, fakeHost(200, () => ({ ok: false, error: { code: 'x', message: '请求参数有误' } })))
+    expect(await backend.getSetup()).toEqual({ ok: false, message: '请求参数有误' })
+  })
+})
+
+const servers = {
+  llm_base_url: 'http://192.168.8.77:8000/v1',
+  prep_base_url: 'http://192.168.8.124:9000',
+  llm_alt_base_url: 'http://10.126.126.1:8000/v1',
+  prep_alt_base_url: null,
+}
+
+describe('needsWelcome（执行令 Q3：settings.json 存在且有 Key 才算配置过）', () => {
+  it('没配置过就显示首次配置页', () => {
+    expect(needsWelcome({ configured: false })).toBe(true)
+    expect(needsWelcome({ configured: true })).toBe(false)
+  })
+})
+
+describe('渲染进程传来的输入', () => {
+  it('合法地址通过；所外地址可为 null', () => {
+    expect(isServerAddresses(servers)).toBe(true)
+  })
+  it('所内地址必须是 http://；拒绝多余字段', () => {
+    expect(isServerAddresses({ ...servers, llm_base_url: 'https://x' })).toBe(false)
+    expect(isServerAddresses({ ...servers, llm_base_url: 'file:///c:/x' })).toBe(false)
+    expect(isServerAddresses({ ...servers, extra: 1 })).toBe(false)
+    expect(isServerAddresses({ ...servers, prep_base_url: null })).toBe(false)
+  })
+  it('Key 可省略；给了就必须是 8–512 位可见 ASCII', () => {
+    expect(isFirstRunInput({ servers })).toBe(true)
+    expect(isFirstRunInput({ servers, key: 'sk-12345678' })).toBe(true)
+    expect(isFirstRunInput({ servers, key: 'short' })).toBe(false)
+    expect(isFirstRunInput({ servers, key: 'has space in it' })).toBe(false)
+    expect(isFirstRunInput({ servers, key: '中文密钥中文密钥中文' })).toBe(false)
+    expect(isFirstRunInput({ servers, other: 1 })).toBe(false)
+    expect(isFirstRunInput(null)).toBe(false)
+  })
+})
